  "bundles": [
    {"id": "vllm-int4-quick-reduce-decode", "frameworks": ["vllm"], "members": [{"name": "VLLM_ROCM_QUICK_REDUCE_QUANTIZATION", "value": "INT4"}, {"name": "VLLM_ROCM_QUICK_REDUCE_QUANTIZATION_MIN_SIZE_KB", "value": "256"}], "when": "TP decode where the all-reduce is a visible share of the step. Without the minimum size the default INT4 gate (16 MB at bf16 TP4) keeps ~1.5 MB decode all-reduces in full precision, so INT4 alone never fires (#1089). The recipes add VLLM_ROCM_QUICK_REDUCE_CAST_BF16_TO_FP16=0 with it (#1050, #1089). NUMERICS: accuracy gate.", "source": "amd-knobs.md §0 rule 6, §5; big-directions.md D4; #1089, #1073, #1165"},
    {"id": "atom-two-batch-overlap", "frameworks": ["atom"], "members": [{"name": "--enable-tbo"}, {"name": "GPU_MAX_HW_QUEUES", "value": "5"}], "when": "DP attention with enough tokens per step; without the queues the two streams serialize. The concurrency threshold moves with the image (#1068); with MTP use prefill-only TBO (#1067).", "source": "amd-knobs.md §0 rule 6, §3, §8; big-directions.md D5; #877, #995, #1067"},
    {"id": "sglang-two-batch-overlap", "frameworks": ["sglang"], "members": [{"name": "--enable-two-batch-overlap"}, {"name": "GPU_MAX_HW_QUEUES", "value": "5"}], "when": "DP attention with enough tokens per step; without the queues the two streams serialize.", "source": "amd-knobs.md §0 rule 6, §2, §8; big-directions.md D5; #877, #995"},
    {"id": "sglang-dp-attention", "frameworks": ["sglang"], "members": [{"name": "--enable-dp-attention"}, {"name": "SGLANG_DP_USE_GATHERV", "value": "1"}, {"name": "SGLANG_DP_USE_REDUCE_SCATTER", "value": "1"}, {"name": "SGLANG_SHARED_EXPERT_TP1", "value": "1"}, {"name": "SGLANG_DP_SHARED_EXPERT_LOCAL", "value": "1"}, {"name": "GPU_MAX_HW_QUEUES", "value": "5"}], "when": "MLA/DSA models at the concurrency where every rank has enough requests; never judged at one concurrency (big-directions.md D8). Known hangs: DSA + DP attention in long-context prefill on ROCm (#1158, #1181).", "source": "amd-knobs.md §0 rule 6, §2; big-directions.md D8; #901, #995"},
    {"id": "vllm-aiter-sparse-paged-attention-minimax-m3", "frameworks": ["vllm"], "members": [{"name": "VLLM_ROCM_USE_AITER", "value": "1"}, {"name": "VLLM_ROCM_SHUFFLE_KV_CACHE_LAYOUT", "value": "1"}, {"name": "--kv-cache-dtype", "value": "fp8"}], "when": "MiniMax-M3 with exactly one KV head per rank (TP4 for its 4 KV heads); nightly-9e57de71+. At short context or low batch the sparse path adds overhead (#1050).", "source": "amd-knobs.md §0 rule 6, §1.2; #1050, #1165"},
