  "bundles": [
    {"id": "vllm-int4-quick-reduce-decode", "frameworks": ["vllm"], "members": [{"name": "VLLM_ROCM_QUICK_REDUCE_QUANTIZATION", "value": "INT4"}, {"name": "VLLM_ROCM_QUICK_REDUCE_QUANTIZATION_MIN_SIZE_KB", "value": "256"}], "when": "TP decode where the all-reduce is a visible share of the step. Without the minimum size the default INT4 gate (16 MB at bf16 TP4) keeps ~1.5 MB decode all-reduces in full precision, so INT4 alone never fires. The recipes add VLLM_ROCM_QUICK_REDUCE_CAST_BF16_TO_FP16=0 with it. NUMERICS: accuracy gate.", "source": "amd-knobs.md §0 rule 6, §5; big-directions.md D4"},
    {"id": "atom-two-batch-overlap", "frameworks": ["atom"], "members": [{"name": "--enable-tbo"}, {"name": "GPU_MAX_HW_QUEUES", "value": "5"}], "when": "DP attention with enough tokens per step; without the queues the two streams serialize. The concurrency threshold moves with the image; with MTP use prefill-only TBO.", "source": "amd-knobs.md §0 rule 6, §3, §8; big-directions.md D5"},
    {"id": "sglang-two-batch-overlap", "frameworks": ["sglang"], "members": [{"name": "--enable-two-batch-overlap"}, {"name": "GPU_MAX_HW_QUEUES", "value": "5"}], "when": "DP attention with enough tokens per step; without the queues the two streams serialize.", "source": "amd-knobs.md §0 rule 6, §2, §8; big-directions.md D5"},
    {"id": "sglang-dp-attention", "frameworks": ["sglang"], "members": [{"name": "--enable-dp-attention"}, {"name": "SGLANG_DP_USE_GATHERV", "value": "1"}, {"name": "SGLANG_DP_USE_REDUCE_SCATTER", "value": "1"}, {"name": "SGLANG_SHARED_EXPERT_TP1", "value": "1"}, {"name": "SGLANG_DP_SHARED_EXPERT_LOCAL", "value": "1"}, {"name": "GPU_MAX_HW_QUEUES", "value": "5"}], "when": "MLA/DSA models at the concurrency where every rank has enough requests; never judged at one concurrency (big-directions.md D8). Known hangs: DSA + DP attention in long-context prefill on ROCm.", "source": "amd-knobs.md §0 rule 6, §2; big-directions.md D8"},
    {"id": "vllm-aiter-sparse-paged-attention-one-kv-head", "frameworks": ["vllm"], "members": [{"name": "VLLM_ROCM_USE_AITER", "value": "1"}, {"name": "VLLM_ROCM_SHUFFLE_KV_CACHE_LAYOUT", "value": "1"}, {"name": "--kv-cache-dtype", "value": "fp8"}], "when": "A model with exactly one KV head per rank (TP4 for 4 KV heads); nightly-9e57de71+. At short context or low batch the sparse path adds overhead.", "source": "amd-knobs.md §0 rule 6, §1.2"},
    {"id": "vllm-aiter-paged-attention-shuffled-kv", "frameworks": ["vllm"], "members": [{"name": "VLLM_ROCM_SHUFFLE_KV_CACHE_LAYOUT", "value": "1"}, {"name": "--block-size", "value": "16"}], "when": "Model-dependent; catalogued on MI355X at 1k1k non-EP and at 8k1k with c>=64. Price it on this node.", "source": "amd-knobs.md §0 rule 6, §1.2"},
    {"id": "vllm-aiter-unified-attention", "frameworks": ["vllm"], "members": [{"name": "--attention-backend", "value": "ROCM_AITER_UNIFIED_ATTN"}, {"name": "VLLM_ROCM_USE_AITER_MHA", "value": "0"}, {"name": "--block-size", "value": "64"}], "when": "Since vLLM v0.17 unified attention is selected with the CLI flag; before it, with VLLM_ROCM_USE_AITER_UNIFIED_ATTENTION=1 plus the master switch.", "source": "amd-knobs.md §0 rule 6, §1.2"},
    {"id": "sglang-aiter-unified-attention", "frameworks": ["sglang"], "members": [{"name": "SGLANG_USE_AITER_UNIFIED_ATTN", "value": "1"}, {"name": "--attention-backend", "value": "aiter"}, {"name": "--page-size", "value": "16"}], "when": "SGLang v0.5.12.post1+.", "source": "amd-knobs.md §0 rule 6, §2"},
    {"id": "sglang-aiter-persistent-mla", "frameworks": ["sglang"], "members": [{"name": "SGLANG_AITER_MLA_PERSIST", "value": "1"}, {"name": "--attention-backend", "value": "aiter"}, {"name": "--kv-cache-dtype", "value": "fp8_e4m3"}], "when": "MLA decode with an FP8 KV cache; v0.5.7+. The FP8 KV is NUMERICS.", "source": "amd-knobs.md §0 rule 6, §2"},
    {"id": "vllm-aiter-moe", "frameworks": ["vllm"], "members": [{"name": "VLLM_ROCM_USE_AITER", "value": "1"}, {"name": "VLLM_ROCM_USE_AITER_MOE", "value": "1"}, {"name": "--moe-backend", "value": "aiter"}], "when": "Newer vLLM nightlies, where AITER MoE needs the backend forced. On gfx942 MXFP4 leave the backend on auto.", "source": "amd-knobs.md §0 rule 6, §1.1"},
    {"id": "sglang-glm52-fusions", "frameworks": ["sglang"], "members": [{"name": "--enable-aiter-allreduce-fusion"}, {"name": "--enable-fused-qk-norm-rope"}, {"name": "AITER_USE_FLYDSL_MOE_SORTING", "value": "1"}], "when": "An FP4 MoE model on MI355X at TP4/EP4, judged on P90 interactivity at c8.", "source": "amd-knobs.md §0 rule 6, §2, §4; big-directions.md D3"}
  ]
}
