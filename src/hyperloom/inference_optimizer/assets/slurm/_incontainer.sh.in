#!/usr/bin/env bash
# In-container runner invoked by run_hyperloom.sbatch.
#
# The outer sbatch copies this file verbatim to $USER_DATA_PATH/_incontainer.sh
# and runs it inside the vllm/sglang ROCm container. It relies entirely on env
# vars exported by the launcher (REPO_ID, MODEL_PATH, FRAMEWORK, GPU_TYPE,
# BACKEND, TP, PREC, ISL, OSL, CONC, MODEL_CLASS, TARGET_GAIN, MAX_HOURS, ...).
#
# The kernel-agent conversation backend for the python carrier is chosen by
# HL_KERNEL_BACKEND (codex|claude); the launcher sets a per-cluster default.
set -euo pipefail

echo "[hl] session=$CLAW_SESSION_ID model=$REPO_ID fw=$FRAMEWORK gpu=$GPU_TYPE tp=$TP backend=$BACKEND"

# 1) host alias so the gateway domain resolves to the jump host (SNI).
if [ -n "${HL_HOST_ALIAS_IP:-}" ] && [ -n "${HL_HOST_ALIAS_NAME:-}" ]; then
  if ! grep -q "$HL_HOST_ALIAS_NAME" /etc/hosts 2>/dev/null; then
    echo "${HL_HOST_ALIAS_IP} ${HL_HOST_ALIAS_NAME}" >> /etc/hosts \
      || echo "[hl][warn] cannot write /etc/hosts; ensure --container-writable" >&2
  fi
fi

# 2) gateway reachability preflight (non-fatal; surfaces misconfig early).
curl -sS -o /dev/null -w "[hl] gateway /models HTTP=%{http_code}\n" \
  -H "Authorization: Bearer ${OPENAI_API_KEY:-$SAFE_API_KEY}" \
  "${OPENAI_BASE_URL}/models" || echo "[hl][warn] gateway preflight failed" >&2

# 3) Hyperloom source. Precedence:
#    - if HYPERLOOM_SOURCE_DIR already holds a checkout (pyproject.toml or .git),
#      use it as-is (e.g. a bind-mounted /mnt/vast/hyperloom) -> no network clone;
#    - otherwise clone from GitHub into the default temp dir.
export HYPERLOOM_SOURCE_DIR="${HYPERLOOM_SOURCE_DIR:-/tmp/Hyperloom-main}"
if [ -f "$HYPERLOOM_SOURCE_DIR/pyproject.toml" ] || [ -d "$HYPERLOOM_SOURCE_DIR/.git" ]; then
  echo "[hl] using existing Hyperloom source at $HYPERLOOM_SOURCE_DIR (no clone)"
else
  echo "[hl] cloning Hyperloom into $HYPERLOOM_SOURCE_DIR"
  git clone --depth 1 --branch "${HYPERLOOM_SOURCE_REF:-main}" \
    "${HYPERLOOM_SOURCE_REPO:-https://github.com/AMD-AGI/Hyperloom.git}" "$HYPERLOOM_SOURCE_DIR"
fi
export REPO_ROOT="$HYPERLOOM_SOURCE_DIR"
cd "$REPO_ROOT"

# 4) install optimizer + components on top of the image's /opt/venv ROCm stack.
#    NOTE: post tree-reform (src-layout) the installer lives under assets/.
bash src/hyperloom/inference_optimizer/assets/install.sh
. "${USER_DATA_PATH}/runtime/kernel-agent.env.sh"

RUN_DIR="$USER_DATA_PATH/optimizer_runs"; mkdir -p "$RUN_DIR"
LAUNCH_INFO_FILE="$RUN_DIR/launch_${CLAW_SESSION_ID}.json"

# Build the carrier prompt from ci/prompt_template.md (shared by claude / codex).
# The carrier loads SKILL.md and issues `python -m hyperloom.inference_optimizer.cli optimize` itself.
hl_build_prompt() {
  export TP  # ensure TP is visible to the child python
  python3 - <<'PY'
import os
tpl = open("ci/prompt_template.md").read()
vals = dict(
    model_hf=os.environ["REPO_ID"], model_path=os.environ.get("MODEL_PATH", os.environ["REPO_ID"]),
    gpu_type=os.environ["GPU_TYPE"], gpu_type_lc=os.environ["GPU_TYPE"].lower(),
    framework=os.environ["FRAMEWORK"], precision=os.environ["PREC"],
    tp=os.environ["TP"], ep="1", conc=os.environ["CONC"],
    isl=os.environ["ISL"], osl=os.environ["OSL"], nodes="1",
    random_range_ratio="1.0", target_gain=os.environ["TARGET_GAIN"],
    max_hours=os.environ["MAX_HOURS"], kernel_agent_build_geak_rag_index="1",
    oob_path="", tracelens_root="", multinode_section="", inferenceX_data="(none)",
)
print(tpl.format(**vals))
PY
}

case "$BACKEND" in
  python)
    # Workload envs the Coordinator reuses for baseline -> params -> sweep.
    export TP EP=1 CONC ISL OSL PRECISION="$PREC" NODES=1
    # Kernel-agent conversation backend is orthogonal to the scheduler; the
    # launcher sets a per-cluster default via HL_KERNEL_BACKEND (codex or
    # claude). Override HL_KERNEL_BACKEND to flip it.
    case "${HL_KERNEL_BACKEND:-claude}" in
      codex)  KERNEL_BACKEND_FLAG=--kernel-codex ;;
      claude) KERNEL_BACKEND_FLAG=--kernel-claude ;;
      *) echo "[hl] unknown HL_KERNEL_BACKEND: ${HL_KERNEL_BACKEND:-} (want codex|claude)" >&2; exit 2 ;;
    esac
    exec python3 -m hyperloom.inference_optimizer.cli --verbose optimize \
      --model "$MODEL_PATH" \
      --framework "$FRAMEWORK" \
      --gpu-type "$GPU_TYPE" \
      --model-class "$MODEL_CLASS" \
      --target-gain "$TARGET_GAIN" \
      --max-hours "$MAX_HOURS" \
      --tick-interval-sec 30 \
      "$KERNEL_BACKEND_FLAG" \
      --launch-info-file "$LAUNCH_INFO_FILE"
    ;;
  claude)
    command -v claude >/dev/null 2>&1 || { echo "[hl] claude CLI not in image" >&2; exit 3; }
    # Kernel-opt rewrite ladder fixed to GEAK for the carrier (plan T-series).
    export KERNEL_OPT_BACKEND_ORDER="${KERNEL_OPT_BACKEND_ORDER:-geak}"
    PROMPT="$(hl_build_prompt)"
    claude_args=(-p "$PROMPT")
    if [ "${HL_ALLOW_DANGEROUS_AGENT_PERMISSIONS:-0}" = "1" ]; then
      echo "[hl] WARNING: enabling claude --dangerously-skip-permissions by explicit opt-in" >&2
      claude_args=(--dangerously-skip-permissions "${claude_args[@]}")
    fi
    exec claude "${claude_args[@]}"
    ;;
  codex)
    # --- Codex CLI carrier -------------------------------------------------
    # Outer coding-agent host: `codex exec` loads SKILL.md and drives the same
    # `python -m hyperloom.inference_optimizer.cli optimize` command agentically (analogous to the
    # claude carrier). node/npm come from install.sh (ensure_forge_claude_cli);
    # install the codex CLI on top of that.
    if ! command -v codex >/dev/null 2>&1; then
      echo "[hl] installing codex CLI (@openai/codex) ..."
      command -v npm >/dev/null 2>&1 || { echo "[hl] npm missing; install.sh should provide node/npm" >&2; exit 3; }
      npm config set prefix /usr/local >/dev/null 2>&1 || true
      CODEX_NON_INTERACTIVE=1 npm install -g @openai/codex \
        || { echo "[hl] codex CLI install failed" >&2; exit 3; }
    fi
    command -v codex >/dev/null 2>&1 || { echo "[hl] codex CLI still not on PATH" >&2; exit 3; }
    echo "[hl] codex $(codex --version 2>/dev/null || echo '?')"

    # Point codex at the AMD gateway via a custom OpenAI-compatible provider.
    # codex-cli >=0.144 dropped wire_api="chat"; it only speaks the Responses
    # API. The gateway serves /responses for CODEX_MODEL (verified end-to-end),
    # so default wire_api=responses; HL_CODEX_WIRE_API can override.
    export CODEX_HOME="${CODEX_HOME:-$USER_DATA_PATH/.codex}"
    mkdir -p "$CODEX_HOME"
    [ -n "${SSL_CERT_FILE:-}" ] && export CODEX_CA_CERTIFICATE="${CODEX_CA_CERTIFICATE:-$SSL_CERT_FILE}"
    cat > "$CODEX_HOME/config.toml" <<CODEX_EOF
model = "${CODEX_MODEL:-gpt-5.4}"
model_provider = "amdgw"

[model_providers.amdgw]
name = "AMD Primus gateway"
base_url = "${OPENAI_BASE_URL}"
env_key = "OPENAI_API_KEY"
wire_api = "${HL_CODEX_WIRE_API:-responses}"

# Forward the full container env to the carrier's shell tool. Without this,
# codex-cli defaults to inherit="core" and drops USER_DATA_PATH, so the
# carrier-launched \`python -m hyperloom.inference_optimizer.cli optimize\` falls back to the node-local
# default (/workspace/hyperloom) and its session/patches never reach NFS.
[shell_environment_policy]
inherit = "all"
CODEX_EOF

    # Kernel-opt rewrite ladder fixed to GEAK for the carrier (plan T-series).
    export KERNEL_OPT_BACKEND_ORDER="${KERNEL_OPT_BACKEND_ORDER:-geak}"
    PROMPT="$(hl_build_prompt)"
    # -C $REPO_ROOT: run inside the (git) checkout so the repo-trust check
    # passes. Agent approvals/sandbox stay enabled by default; dedicated
    # internal containers can opt into the legacy bypass with
    # HL_ALLOW_DANGEROUS_AGENT_PERMISSIONS=1.
    codex_args=(exec -C "$REPO_ROOT" -m "${CODEX_MODEL:-gpt-5.4}" "$PROMPT")
    if [ "${HL_ALLOW_DANGEROUS_AGENT_PERMISSIONS:-0}" = "1" ]; then
      echo "[hl] WARNING: enabling codex --dangerously-bypass-approvals-and-sandbox by explicit opt-in" >&2
      codex_args=(exec --dangerously-bypass-approvals-and-sandbox -C "$REPO_ROOT" -m "${CODEX_MODEL:-gpt-5.4}" "$PROMPT")
    fi
    exec codex "${codex_args[@]}"
    ;;
  *)
    echo "[hl] unknown backend: $BACKEND" >&2; exit 2 ;;
esac
