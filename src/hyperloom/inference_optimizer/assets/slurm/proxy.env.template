# Proxy profile for the remote Slurm cluster (Primus Proxy -> global LLM gateway).
# Single source of truth for connectivity. Leave HL_PROXY_ENABLED=0 to run without it.
#
# NOTE: this file is a DESENSITIZED template. Fill in the marked values before use:
#   - OPENAI_API_KEY / SAFE_API_KEY / ANTHROPIC_AUTH_TOKEN : your SaFE ak- key
#   - HL_HOST_ALIAS_IP                                     : gateway jump-host IP
#   - HL_CA_BUNDLE_HOST                                    : path to combined CA bundle

HL_PROXY_ENABLED=1

# (1) host alias: the gateway domain MUST resolve to the jump host (SNI-based nginx).
#     Using the IP directly breaks SNI forwarding and cert validation.
HL_HOST_ALIAS_IP=<GATEWAY_JUMP_HOST_IP>
HL_HOST_ALIAS_NAME=your-openai-compatible-gateway.example.com

# (2) endpoint + auth. The ak- SaFE key authenticates the proxy path unattended.
OPENAI_BASE_URL=https://your-openai-compatible-gateway.example.com/v1
OPENAI_API_KEY=ak-REPLACE_ME
# Hyperloom aliases (install.sh preflight + kernel/critic backends read these).
SAFE_API_KEY=ak-REPLACE_ME
ANTHROPIC_AUTH_TOKEN=ak-REPLACE_ME
# Only used by the claude-code backend (claude CLI reads ANTHROPIC_BASE_URL).
ANTHROPIC_BASE_URL=https://your-openai-compatible-gateway.example.com/api/v1/llm-proxy
# (2b) Gateways that require an extra header (e.g. an AMD subscription key) must
#      declare it explicitly per side — there is NO host-based auto-injection.
#      OpenAI/Codex calls read OPENAI_CUSTOM_HEADERS; Claude calls read
#      ANTHROPIC_CUSTOM_HEADERS. Set BOTH when one gateway serves both sides.
#      Uncomment and fill in for such a gateway (newline-delimited "Name: value"):
# OPENAI_CUSTOM_HEADERS=Ocp-Apim-Subscription-Key: <SUBSCRIPTION_KEY>
# ANTHROPIC_CUSTOM_HEADERS=Ocp-Apim-Subscription-Key: <SUBSCRIPTION_KEY>

# (3) AMD internal CA trust. Point this at a COMBINED bundle (system CAs + AMD CA)
#     so BOTH public TLS (huggingface.co, github.com) AND the AMD gateway verify.
#     Build it once with: cat /etc/ssl/certs/ca-certificates.crt amd-ca.pem > amd-ca-combined.pem
#     Leave HL_CA_BUNDLE_HOST empty if the image already trusts everything needed.
HL_CA_BUNDLE_HOST=/path/to/amd-ca-combined.pem
HL_CA_BUNDLE_CONTAINER=/etc/ssl/amd/amd-ca.pem

# (4) LLM model overrides. Match these to models actually served by your key
#     (list them with: curl $OPENAI_BASE_URL/models). Do NOT use *-thinking-xhigh
#     variants unless the gateway lists them.
#     IMPORTANT: the orchestration model (--claude-model / $CLAUDE_MODEL) is
#     hard-allowlisted by the optimizer to claude-opus-4-8 (preferred),
#     claude-opus-4-7, or claude-opus-4-6 (fallback). GEAKv4 uses Claude Code
#     and follows GEAK_CLAUDE_MODEL. The chosen model must also be served by
#     your gateway (list it with: curl $OPENAI_BASE_URL/models), else preflight
#     falls back.
CURSOR_DEFAULT_MODEL=claude-opus-4-8
GEAK_CLAUDE_MODEL=claude-opus-4-8
CLAUDE_MODEL=claude-opus-4-8
CODEX_MODEL=gpt-5.4
LLM_MODEL=claude-opus-4-8

# (5) GBrain recipe knowledge base (OPTIONAL, opt-in). Lets the optimizer pull
#     prior tuning recipes as priors. To enable: set RECIPE_KB_REMOTE=gbrain,
#     fill GBRAIN_TOKEN, and turn on the KG flags. Left off by default so a
#     freshly-copied template makes no unauthenticated GBrain calls.
RECIPE_KB_REMOTE=
GBRAIN_BASE_URL=https://your-openai-compatible-gateway.example.com/gbrain
#GBRAIN_TOKEN=gbrain_REPLACE_ME
GBRAIN_KG_GUIDED=0
GBRAIN_KG_NATIVE=0
GBRAIN_RECIPE_SCAN_BUDGET_SEC=60

# (6) Langfuse tracing (OPTIONAL, opt-in). Emits optimization traces to a
#     Langfuse instance. To enable: set HYPERLOOM_LANGFUSE_ENABLE=1 and fill the
#     keys below. Left off by default to avoid noisy auth failures on copy.
HYPERLOOM_LANGFUSE_ENABLE=0
LANGFUSE_HOST=https://your-openai-compatible-gateway.example.com/langfuse
#LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_ME
#LANGFUSE_SECRET_KEY=sk-lf-REPLACE_ME

# (optional) HuggingFace token for gated weights.
HF_TOKEN=
