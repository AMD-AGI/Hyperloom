{
  "framework": "sglang",
  "repo_url": "https://github.com/sgl-project/sglang.git",
  "work_dir": "/tmp/framework-agent/sglang-execute",
  "baseline": {
    "throughput": 100000000.0,
    "accuracy": 0.95,
    "completed": "200/200"
  },
  "thresholds": {
    "min_throughput_ratio": 1.05,
    "max_accuracy_drop": 0.05
  },
  "candidate_refs": [],
  "search_perf_prs": true,
  "max_search_candidates": 2,
  "pr_monitor": {
    "base_url": "https://your-pr-monitor.example",
    "timeout_sec": 10.0
  },
  "search_modes": ["pr_monitor"],
  "gap_description": "improve sglang fp8 MoE attention on AMD ROCm MI300X",
  "prepare_candidate_env": false,
  "commands": {
    "benchmark": {
      "command": "python3 {work_dir}/_bin/bench_rmsnorm.py --out {candidate_dir}/benchmark.json --iters 200",
      "timeout_sec": 120,
      "required": true
    },
    "accuracy": {
      "command": "python3 {work_dir}/_bin/check_accuracy_rmsnorm.py --out {candidate_dir}/accuracy.json",
      "timeout_sec": 120,
      "required": true
    }
  },
  "outputs": {
    "benchmark_json": "{candidate_dir}/benchmark.json",
    "accuracy_json": "{candidate_dir}/accuracy.json"
  }
}
