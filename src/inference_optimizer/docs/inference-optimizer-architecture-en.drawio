                <mxCell id="s4-step5" value="5) Conductor arbitrates: create task after mode/policy/lock/scheduler all pass" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fillColor=#ffffff;" vertex="1" parent="1">
