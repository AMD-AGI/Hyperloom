                </mxCell>
                <mxCell id="s4-sage" value="Sage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#b85450;fontStyle=1;strokeWidth=2" vertex="1" parent="1">
                    <mxGeometry x="880" y="90" width="120" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="s4-sub" value="Sub-agent&#10;(bench/profile/patch/eval)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1">
                    <mxGeometry x="1080" y="90" width="150" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="s4-watchdog" value="Watchdog&#10;(marathon resident)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1">
