                <mxCell id="s4-t7a" value="delegated_result(task_id, metrics, eval)" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fillColor=#ffffff;" vertex="1" parent="1">
                    <mxGeometry x="620" y="765" width="300" height="20" as="geometry"/>
