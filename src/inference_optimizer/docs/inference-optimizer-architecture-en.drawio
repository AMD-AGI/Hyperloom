                <mxCell id="s4-box6" value="sub-agent output:&#10;metrics.json&#10;patch/result artifact&#10;gsm8k eval summary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
