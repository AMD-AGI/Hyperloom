                <mxCell id="s4-t-watchdog" value="alert / do_emergency_rca / rca_done" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#b85450;fillColor=#ffffff;" vertex="1" parent="1">
                    <mxGeometry x="760" y="685" width="300" height="20" as="geometry"/>
