                <mxCell id="s4-step1" value="1) trigger @inference-optimizer (MAX_HOURS=24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fillColor=#ffffff;" vertex="1" parent="1">
