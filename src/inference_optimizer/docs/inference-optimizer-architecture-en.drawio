                <mxCell id="s4-t7b" value="Executor: propose_decision(KEEP)" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fillColor=#ffffff;" vertex="1" parent="1">
                    <mxGeometry x="350" y="795" width="230" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="s4-t7c" value="Conductor → Critic: please final-review KEEP/REVERT" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fillColor=#ffffff;" vertex="1" parent="1">
                    <mxGeometry x="430" y="825" width="300" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="s4-t7d" value="Critic: vote(KEEP) / objection(REVERT)" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fillColor=#ffffff;" vertex="1" parent="1">
                    <mxGeometry x="430" y="855" width="260" height="20" as="geometry"/>
