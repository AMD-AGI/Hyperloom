                <mxCell id="lock-workspace" value="workspace_mutation&#10;━━━━━━━━━━━━&#10;Holders: write patch&#10;            modify inductor cache&#10;            modify config files&#10;━━━━━━━━━━━━&#10;TTL: &lt;30s&#10;Exclusive by default (can evolve to reader/writer later)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;verticalAlign=top;strokeWidth=2" vertex="1" parent="1">
