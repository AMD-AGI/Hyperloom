{
  "mcpServers": {
    "oci-traceLens-agent": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://oci-slc.example-internal-host.invalid/control-plane/control-plane-dev/trace-lens-agent-qqpfv/mcp"
      ],
      "env": {
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      }
    },
    "geak-agent": {
      "url": "https://oci-slc.example-internal-host.invalid/control-plane/control-plane-dev/geak-agent-wvsbv/mcp/sse",
      "headers": {
        "Authorization": "Bearer ${GEAK_AUTH_KEY}"
      }
    }
  }
}
