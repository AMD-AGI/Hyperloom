    hyperloom.inference_optimizer.cli.preflight -> hyperloom.orchestrator.actions.executors._aiter_jit
    hyperloom.inference_optimizer.cli.preflight -> hyperloom.orchestrator.actions.executors._inferencex_patcher
    hyperloom.inference_optimizer.cli.preflight -> hyperloom.orchestrator.actions.executors._magpie_patcher
    hyperloom.inference_optimizer.cli.preflight -> hyperloom.orchestrator.actions.executors._multi_node_env
    hyperloom.inference_optimizer.cli.preflight -> hyperloom.orchestrator.actions.executors._subprocess_kill
    hyperloom.inference_optimizer.cli.preflight -> hyperloom.orchestrator.actions.executors.benchmark_backend
    hyperloom.inference_optimizer.cli.quantization -> hyperloom.orchestrator.phases.quantization_request_handlers
    hyperloom.inference_optimizer.cli.quantization -> hyperloom.orchestrator.phases.quantization_schemes
unmatched_ignore_imports_alerting = error


[importlinter:contract:kf-only-common]
name = kernelforge may depend on hyperloom.common only
type = forbidden
source_modules = kernelforge
forbidden_modules =
    hyperloom.cli
    hyperloom.orchestrator
    hyperloom.inference_optimizer
    hyperloom.agents
ignore_imports =
    hyperloom.**.tests.** -> **
    kernelforge.tests.** -> **
    kernelforge.**.tests.** -> **
    kernelforge.conftest -> **
unmatched_ignore_imports_alerting = none


[importlinter:contract:common-is-leaf]
name = hyperloom.common imports nothing else from the project
type = forbidden
source_modules = hyperloom.common
forbidden_modules =
    hyperloom.cli
    hyperloom.orchestrator
    hyperloom.inference_optimizer
    hyperloom.agents
    kernelforge
ignore_imports =
    hyperloom.**.tests.** -> **
    kernelforge.tests.** -> **
    kernelforge.**.tests.** -> **
    kernelforge.conftest -> **
unmatched_ignore_imports_alerting = none


[importlinter:contract:agents-independent]
name = agent packages are independent
type = independence
# A new package under hyperloom/agents/ must be added here.
modules =
    hyperloom.agents.critic
    hyperloom.agents.framework
    hyperloom.agents.quantization
ignore_imports =
    hyperloom.**.tests.** -> **
    kernelforge.tests.** -> **
    kernelforge.**.tests.** -> **
    kernelforge.conftest -> **
unmatched_ignore_imports_alerting = none


[importlinter:contract:kf-backends-independent]
name = kernel backends are independent
type = independence
# A new package under kernelforge/kernel_backends/ must be added here.
modules =
    kernelforge.kernel_backends.aiter
    kernelforge.kernel_backends.assembly
    kernelforge.kernel_backends.ck
    kernelforge.kernel_backends.flydsl
    kernelforge.kernel_backends.fusion
    kernelforge.kernel_backends.gluon
    kernelforge.kernel_backends.hip
    kernelforge.kernel_backends.hipblaslt
    kernelforge.kernel_backends.triton
ignore_imports =
    hyperloom.**.tests.** -> **
    kernelforge.tests.** -> **
    kernelforge.**.tests.** -> **
    kernelforge.conftest -> **
unmatched_ignore_imports_alerting = none


[importlinter:contract:kf-entry-protected]
name = hyperloom.agents, inference_optimizer and common do not import kernelforge directly
type = forbidden
# kernelforge is reached from hyperloom only through hyperloom.cli and the
# orchestrator (kernel, measurement, trace_analysis).
source_modules =
    hyperloom.agents
    hyperloom.inference_optimizer
    hyperloom.common
forbidden_modules = kernelforge
allow_indirect_imports = True
ignore_imports =
    hyperloom.**.tests.** -> **
    kernelforge.tests.** -> **
    kernelforge.**.tests.** -> **
    kernelforge.conftest -> **
unmatched_ignore_imports_alerting = none


[importlinter:contract:acyclic]
name = no cycles between sibling packages (baseline may only shrink)
type = acyclic_siblings
ancestors =
    hyperloom
    kernelforge
# Baseline: the exact imports import-linter nominates as cycle breakers on
# main today. Removing one of these imports means deleting its line here.
