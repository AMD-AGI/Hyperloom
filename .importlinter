# SPDX-FileCopyrightText: 2026 Advanced Micro Devices, Inc.
# SPDX-License-Identifier: MIT
#
# Architecture contracts, checked by import-linter (`lint-imports`) in
# lint.yml and in the pre-commit `import-linter` hook. See
# docs/contributing/style-guide.md "Dependency direction" for the rules these
# encode.
#
# Run locally (no install of the project needed):
#     pip install "import-linter==2.15"
#     PYTHONPATH=src lint-imports --no-cache
#
# Two contracts carry a baseline of existing violations as exact
# `importer -> imported` lines under ignore_imports (hl-top-layers and
# acyclic). Both set unmatched_ignore_imports_alerting = error, so the
# baselines only shrink: an import that is removed must also be deleted from
# its list here, or the check fails with "No matches for ignored import".
# Never add a line to a baseline to get a new import through; fix the
# direction instead (move the code down a layer, or invert the dependency).
#
# Tests are exempt from every contract (the tests globs below): they exercise
# code across layers by design.
#
# Imports under `if TYPE_CHECKING:` are excluded: the contracts describe
# runtime dependency direction. Imports inside functions ARE seen.

[importlinter]
root_packages =
    hyperloom
    kernelforge
include_external_packages = False
exclude_type_checking_imports = True


[importlinter:contract:hl-top-layers]
name = hyperloom top-level layers (cli > orchestrator > agents > inference_optimizer > common)
type = layers
layers =
    hyperloom.cli
    hyperloom.orchestrator
    hyperloom.agents
    hyperloom.inference_optimizer
    hyperloom.common
# Baseline: hyperloom.inference_optimizer.cli is an entry point that lives
# inside the inference_optimizer layer, so its imports of orchestrator/agents
# point upward. These are its exact current upward imports; the list may only
# shrink (moving inference_optimizer.cli up to an entry package removes it).
ignore_imports =
    hyperloom.**.tests.** -> **
    kernelforge.tests.** -> **
    kernelforge.**.tests.** -> **
    kernelforge.conftest -> **
    hyperloom.inference_optimizer.cli -> hyperloom.orchestrator.actions.executors._aiter_jit
    hyperloom.inference_optimizer.cli -> hyperloom.orchestrator.actions.executors._partition_shape
    hyperloom.inference_optimizer.cli -> hyperloom.orchestrator.actions.executors._subprocess_kill
    hyperloom.inference_optimizer.cli -> hyperloom.orchestrator.actions.executors._workload_envs
    hyperloom.inference_optimizer.cli -> hyperloom.orchestrator.actions.executors.benchmark_backend
    hyperloom.inference_optimizer.cli -> hyperloom.orchestrator.actions.executors.bypass_scriptable
    hyperloom.inference_optimizer.cli -> hyperloom.orchestrator.bus.resource_lock
    hyperloom.inference_optimizer.cli -> hyperloom.orchestrator.collaborator
    hyperloom.inference_optimizer.cli -> hyperloom.orchestrator.loop.coordinator
    hyperloom.inference_optimizer.cli -> hyperloom.orchestrator.phases.machine_state
    hyperloom.inference_optimizer.cli -> hyperloom.orchestrator.prompts.prompt_builder
    hyperloom.inference_optimizer.cli -> hyperloom.orchestrator.state.objective
    hyperloom.inference_optimizer.cli -> hyperloom.orchestrator.state.shared_state
    hyperloom.inference_optimizer.cli.backends -> hyperloom.orchestrator.roles
    hyperloom.inference_optimizer.cli.backends -> hyperloom.orchestrator.roles.agent_role
    hyperloom.inference_optimizer.cli.backends -> hyperloom.orchestrator.scoring.proposal_scorer
    hyperloom.inference_optimizer.cli.bootstrap -> hyperloom.orchestrator.actions.executors._workload_envs
    hyperloom.inference_optimizer.cli.bootstrap -> hyperloom.orchestrator.actions.executors.report
    hyperloom.inference_optimizer.cli.bootstrap -> hyperloom.orchestrator.kernel.conc_sweep
    hyperloom.inference_optimizer.cli.bootstrap -> hyperloom.orchestrator.phases.machine_state
    hyperloom.inference_optimizer.cli.bootstrap -> hyperloom.orchestrator.policy.gate
    hyperloom.inference_optimizer.cli.bootstrap -> hyperloom.orchestrator.prompts
    hyperloom.inference_optimizer.cli.bootstrap -> hyperloom.orchestrator.state.shared_state
    hyperloom.inference_optimizer.cli.executors -> hyperloom.orchestrator.actions.executors
    hyperloom.inference_optimizer.cli.executors -> hyperloom.orchestrator.actions.executors.integrate_patch
