# Hyperloom Fully Local Mode — SGLang base image
# Bundles: TraceLens CLI + GEAK CLI (geak via Ray) + OOB CLI (oob run) + InferenceX + Skills + SSH
#
# No local build context needed — all repo artifacts come from hyperloom-src.
#   Prereq: docker pull docker.io/primussafe/hyperloom-src:<tag>
#   docker build -f deploy/fully-local/Dockerfile.sglang -t hyperloom-local:sglang-latest .

# Stage 0: repo source bundle (OOB, TraceLens, InferenceX, skills, deploy scripts)
FROM primussafe/hyperloom-src-427:v1.0.0 AS hyperloom-src

FROM lmsysorg/sglang:v0.5.9-rocm700-mi30x

# --- Layer 1: system deps + Node.js 20 (rarely changes, best cache hit) ---
RUN apt-get update && apt-get install -y --no-install-recommends \
        openssh-server curl gnupg ca-certificates \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && curl -fsSL https://raw.githubusercontent.com/AMD-AGI/Primus-SaFE/main/Scripts/setup-certs/amd-root-ca.crt \
        -o /usr/local/share/ca-certificates/amd-root-ca.crt \
    && curl -fsSL https://raw.githubusercontent.com/AMD-AGI/Primus-SaFE/main/Scripts/setup-certs/amd-issuing-ca.crt \
        -o /usr/local/share/ca-certificates/amd-issuing-ca.crt \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd /opt/hyperloom/.cursor/skills /tmp/geak-data /tmp/agent-workspaces \
    && echo 'PermitRootLogin yes' >> /etc/ssh/sshd_config \
    && echo 'root:root' | chpasswd

# --- Layer 2: GEAK + intellikit (pinned branches, single layer) ---
# Pin IntelliKit to a known-good SHA for reproducible builds (issue #62).
# Keep aligned with GEAK/pyproject.toml; bump both together.
ARG INTELLIKIT_SHA=bcbfa0252df9d55f3aab68c95dd3ce45ccbe5b46
RUN git clone --depth 1 \
        https://github.com/AMD-AGI/GEAK.git /opt/geak \
    && git clone https://github.com/AMDResearch/intellikit.git /opt/intellikit \
    && git -C /opt/intellikit checkout ${INTELLIKIT_SHA} \
    && cd /opt/geak && pip install --no-cache-dir -e . \
    && pip install --no-cache-dir -e /opt/intellikit/metrix/ \
    && pip install --no-cache-dir ray "click<8.3"

# --- Layer 3: TraceLens (changes moderately) ---
COPY --from=hyperloom-src /TraceLens /opt/TraceLens
RUN cd /opt/TraceLens && pip install --no-cache-dir -e .

# --- Layer 3.5: OOB Agent deps (Node CLIs + Python SDK) ---
COPY --from=hyperloom-src /OOB/oob_cli/requirements.txt /tmp/oob-requirements.txt
RUN pip install --no-cache-dir -r /tmp/oob-requirements.txt \
    && CERTIFI_BUNDLE=$(python3 -c "import certifi; print(certifi.where())" 2>/dev/null) \
    && if [ -n "$CERTIFI_BUNDLE" ]; then \
         cat /usr/local/share/ca-certificates/amd-root-ca.crt \
             /usr/local/share/ca-certificates/amd-issuing-ca.crt >> "$CERTIFI_BUNDLE"; \
       fi \
    && npm install -g @anthropic-ai/claude-code @openai/codex@0.100.0

# --- Layer 4: lightweight copies (change most often, minimal rebuild) ---
COPY --from=hyperloom-src /InferenceX /opt/hyperloom/InferenceX
COPY --from=hyperloom-src /skills/inference-optimization \
     /opt/hyperloom/.cursor/skills/inference-optimization
COPY --from=hyperloom-src /OOB /opt/OOB
COPY --from=hyperloom-src /deploy/entrypoint.sh /opt/entrypoint.sh
COPY --from=hyperloom-src /deploy/hyperloom-autostart.sh /etc/profile.d/hyperloom.sh
COPY --from=hyperloom-src /deploy/geak-litellm.yaml /opt/hyperloom/geak-config/template.yaml
# Install OOB as an editable package so the `oob` console script (defined in
# pyproject.toml [project.scripts]) lands on PATH for `oob run ...` invocations.
RUN pip install --no-cache-dir -e /opt/OOB/oob_cli \
    && chmod +x /opt/entrypoint.sh /etc/profile.d/hyperloom.sh \
    && git config --global user.email "hyperloom@local" \
    && git config --global user.name  "Hyperloom Local" \
    && git config --global init.defaultBranch main
ENV PATH="/opt/venv/bin:${PATH}" \
    MODE=fully-local \
    GEAK_MODEL_NAME=claude-opus-4-7 \
    GEAK_CONFIG=/opt/hyperloom/geak-config/local.yaml \
    GEAK_LOCAL=true \
    OOB_LOCAL=true \
    OOB_CLI=oob \
    KERNEL_OPT_BACKENDS=geak \
    NFS_BASE_PATH=/tmp/geak-data \
    INFERENCEX_PATH=/opt/hyperloom/InferenceX \
    FRAMEWORK=sglang \
    AGENT_WORKSPACE_ROOT=/tmp/agent-workspaces \
    PYTHONPATH=/opt/OOB \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

EXPOSE 22 6379 8265
ENTRYPOINT ["/opt/entrypoint.sh"]
CMD []
