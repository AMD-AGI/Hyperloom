# Environment and secrets
.env
*.env
!*.env.template
kernel-agent/env.sh
# Written by framework-agent/scripts/install.sh, and it bakes in the venv path of
# whichever machine ran it.
framework-agent/scripts/env.sh

# Dependency checkout cache (deps_cache_root default: $REPO_ROOT/.cache)
.cache/

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# Wheel build output (scripts/build_wheel.sh, python -m build)
/build/
/dist/

# Large trace / profile files (regenerated by the agent)
*.trace.json
*.trace.json.gz
*.prof
*.hprof
trace_rank*.json
.rocprofv3/

# Optimization run artifacts (runtime per-session output; ignored).
optimizer_runs/*
optimization_logs/
optimization_reports/
optimized_versions/
benchmarks/
kernel-agent/runs/
inference_optimizer/runs/
.optimization_strategies.md
optimization_report.md
/bench.py
src/hyperloom/framework-agent/kb/framework_optimization/lessons.jsonl

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test / coverage artifacts
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/

# Logs
*.log

# Skill run results (large, regenerated by agent)
.cursor/skills/*/results/

# PR description scratchpads and local review notes.
pr.md
pr_*.md
*.issue.md
Specialist.discuss.md
specialist.discuss*.md
specialist.info.md

# F0/F1 integration: keep test baselines, dry-run merge maps, and
# archived regression sweeps tracked.
!docs/test-baselines/*.log
!docs/integration/*.log
!docs/integration/logs/*.log

# claude files
*.claude
CLAUDE.md
.agents
skills-lock.json

# temp file
code_functions_guidance_v2
.gen_funcdocs.wf.js
.gen_funcdocs_reboot.wf.js
evaluation_analysis
code-clean-ref


# Operator runtime env (contains real API keys — never commit)
runtime-env/

# Personal per-operator launch/resume scratch scripts (worktree- and
# framework-specific; not part of the product). Keep them out of the repo.
run_kernel_forge.sh
resume_kernel_forge.sh
vllm_mi355x_kimik3.sh

# Sky-segmentation model HY-World-2.0 downloads at run time. inference_utils
# resolves it by relative path, so it lands in whatever CWD the bench ran from.
skyseg.onnx
# Local prompt-audit scratch (rendered prompts, session dumps, audit notes)
.prompt-audit/
# Scratch plan and revision files
*.plan.md
# Experiment and repro artefacts
/prefix_cache_repro/
# Operator analysis output written at the repo root: session/cost/tuning exports
# and rendered reports. Anchored so the same extensions stay tracked elsewhere.
/*.csv
/*.pptx
/*.html
kimik3-wares
