# Environment and secrets
.env
*.env
!*.env.template
kernel-agent/env.sh
framework-agent/scripts/env.sh

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# Large trace / profile files (regenerated by the agent)
*.trace.json
*.trace.json.gz
*.prof
*.hprof
trace_rank*.json
.rocprofv3/

# Optimization run artifacts (runtime per-session output; ignored). One
# tracked exception: the .example template SKILL.md tells operators to
# `cp` from at session start. Use ``optimizer_runs/*`` (not the bare
# ``optimizer_runs/`` directory) so git still recurses into the dir
# and the negation pattern below can re-include the .example file.
optimizer_runs/*
!optimizer_runs/robustness_monitor.sh.example
optimization_logs/
optimization_reports/
optimized_versions/
benchmarks/
marathon-runs/
marathon-sessions/
kernel-agent/runs/
inference_optimizer/runs/
.optimization_strategies.md
optimization_report.md
bench.py
ci/claw-integration.md

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Skill run results (large, regenerated by agent)
.cursor/skills/*/results/

# Local working notes
inference_optimizer/remain_todo.md
inference_optimizer/remain_issue.md
inference_optimizer/remain_robustness_todo.md

# PR description scratchpad. Tools (gh CLI, codex) sometimes drop a
# pr.md at the repo root when drafting a pull request; the
# description belongs in the PR body, not in the tree.
pr.md

# F0/F1 integration: keep test baselines, dry-run merge maps, and
# archived regression sweeps tracked.
!docs/test-baselines/*.log
!docs/integration/*.log
!docs/integration/logs/*.log

# claude files
*.claude
CLAUDE.md
boost_trap_files
atom_boost_tutorials.md

#clean-up files
./code-cleansing-plan
code_cleansing.MD
