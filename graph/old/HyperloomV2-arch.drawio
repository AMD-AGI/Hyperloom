        <mxCell id="sub_critic" value="&lt;b&gt;critic-agent/&lt;/b&gt; ★ 真子进程&lt;br&gt;runtime/cli.py · decision_reviewer.py (27KB) · kb_writer.py (24KB) ·&lt;br&gt;session_memory.py (14KB) · in_memory_kb_client · inbox_parser ·&lt;br&gt;intent_envelope · request_models · scope_builder · dead_letter&lt;br&gt;actions/{draft_kb · objection_signal · review_coordinator_inbox ·&lt;br&gt;review_decision · review_patch}.md + references/ + SKILL.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D14B4B;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
