        <mxCell id="back_claude" value="&lt;b&gt;claude.py&lt;/b&gt; (12KB)&lt;br&gt;Anthropic SDK tool-using&lt;br&gt;orch / kernel / robustness 共用&lt;br&gt;+ emit_intent 工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
