          <mxGeometry x="40" y="246" width="2120" height="1080" as="geometry" />
        </mxCell>

        <mxCell id="coord_label" value="&lt;b&gt;Coordinator — orchestrator/coordinator.py (2949 行 · 单 asyncio 进程)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFD9F2;strokeColor=#10497F;fontColor=#000000;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="260" width="2080" height="36" as="geometry" />
