        <mxCell id="comp_label" value="&lt;b&gt;Coordinator-owned 组件&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontColor=#000000;fontSize=14;fontStyle=4;" vertex="1" parent="1">
