        <mxCell id="comp_state" value="&lt;b&gt;SharedState&lt;/b&gt; (1842 行)&lt;br&gt;state.json 唯一写入&lt;br&gt;atomic tmp+rename&lt;br&gt;CORE_STATE_FIELDS 守门:&lt;br&gt;current_best · stop_reason ·&lt;br&gt;cumulative_gain* · baseline_*&lt;br&gt;session_id · model_path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="332" width="335" height="130" as="geometry" />
        </mxCell>

        <mxCell id="comp_bus" value="&lt;b&gt;MessageBus&lt;/b&gt;&lt;br&gt;events 表 = source of truth&lt;br&gt;seq AUTOINCREMENT (replay-safe)&lt;br&gt;TOPIC_ALLOWLIST 23 项:&lt;br&gt;proposal · question · answer ·&lt;br&gt;alert · request · response ·&lt;br&gt;review_verdict · kill · heartbeat ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="405" y="332" width="335" height="130" as="geometry" />
        </mxCell>

        <mxCell id="comp_tasks" value="&lt;b&gt;TaskRegistry&lt;/b&gt;&lt;br&gt;tasks 表 + DelegatedTask FSM&lt;br&gt;queued → running →&lt;br&gt;succeeded / failed / cancelled /&lt;br&gt;needs_manual_review&lt;br&gt;idempotency_key UNIQUE (天然去重)&lt;br&gt;requires_lanes · allowed_tools · history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="750" y="332" width="335" height="130" as="geometry" />
        </mxCell>

        <mxCell id="comp_cursor" value="&lt;b&gt;CursorStore&lt;/b&gt;&lt;br&gt;cursors 表 (per-agent):&lt;br&gt;last_processed_seq +&lt;br&gt;last_processed_msg_id +&lt;br&gt;processed_at&lt;br&gt;→ 幂等回放, 重启不重复消费&lt;br&gt;每个 reactor tick 推进自己的 cursor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1095" y="332" width="335" height="130" as="geometry" />
        </mxCell>

        <mxCell id="comp_lock" value="&lt;b&gt;ResourceLockManager&lt;/b&gt;&lt;br&gt;leases 表 (lane=PK) + BEGIN IMMEDIATE&lt;br&gt;KNOWN_LANES (4):&lt;br&gt;server_lifecycle · workspace_mutation&lt;br&gt;benchmark_lane · profile_lane&lt;br&gt;LANE_CONFLICTS: bench ↔ profile ↔&lt;br&gt;server_lifecycle (busy → ROLLBACK)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1440" y="332" width="350" height="130" as="geometry" />
        </mxCell>

        <mxCell id="comp_obj" value="&lt;b&gt;Objective&lt;/b&gt; (objective.py)&lt;br&gt;Coordinator 判 stop&lt;br&gt;&lt;br&gt;TimeOnlyObjective (默认)&lt;br&gt;或 GainObjective&lt;br&gt;(target_gain / target_tput /&lt;br&gt;target_baseline_dir)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1800" y="332" width="360" height="130" as="geometry" />
        </mxCell>

        <mxCell id="comp_reg" value="&lt;b&gt;ActionRegistry&lt;/b&gt; — 扫描 actions/_meta/*.yaml (20 条) → ActionMetadata&lt;br&gt;字段: family · cost_p50/p75 · expected_gain_pct[low,high] · accuracy_risk · crash_risk · requires_lanes · allowed_tools · side_effects · max_turns · lease_ttl_sec · pipeline_phase&lt;br&gt;&lt;b&gt;VALID_FAMILIES (7):&lt;/b&gt; prep · analysis · shallow · deep_kernel · long · creative · resilience&lt;br&gt;&lt;b&gt;VALID_PIPELINE_PHASES (8):&lt;/b&gt; prep · measure · explore · analysis · deep · validate · finalize · support" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="478" width="1030" height="100" as="geometry" />
        </mxCell>

        <mxCell id="comp_runner" value="&lt;b&gt;SubAgentRunner&lt;/b&gt;&lt;br&gt;消费 TaskRegistry → 调对应 action_executors async fn&lt;br&gt;先 ResourceLockManager.acquire_many(requires_lanes)&lt;br&gt;成功 → tasks.state=running → 跑 → succeeded/failed&lt;br&gt;失败 → 释放 leases + alert + audit_trail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1100" y="478" width="555" height="100" as="geometry" />
        </mxCell>

        <mxCell id="comp_kreq" value="&lt;b&gt;KERNEL_REQUEST_HANDLERS&lt;/b&gt; (52KB)&lt;br&gt;&lt;b&gt;4 kind:&lt;/b&gt; select_kernels · run_optimization · integrate · apply_patch&lt;br&gt;⚠ kernel_opt 不是 request kind&lt;br&gt;同进程 import kernel-agent/tools/*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1665" y="478" width="495" height="100" as="geometry" />
        </mxCell>

        <mxCell id="agents_label" value="&lt;b&gt;4 个 Reactor 角色&lt;/b&gt; (agent_role.py · default_role_registry)" style="text;html=1;align=center;verticalAlign=middle;fontColor=#000000;fontSize=14;fontStyle=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="590" width="2080" height="22" as="geometry" />
        </mxCell>

        <mxCell id="R_orch" value="&lt;b&gt;orchestration&lt;/b&gt;&lt;br&gt;backend: Claude opus-4-7 · tool-using&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;allowed_intents:&lt;/b&gt;&lt;br&gt;base + &lt;b&gt;propose_action&lt;/b&gt; · &lt;b&gt;delegate&lt;/b&gt;&lt;br&gt;&lt;b&gt;request&lt;/b&gt; · &lt;b&gt;update_state&lt;/b&gt;&lt;br&gt;━━━━━━━━━━&lt;br&gt;唯一可发 REQUEST 的角色&lt;br&gt;(routing target → kernel only)&lt;br&gt;can_delegate_side_effects = True&lt;br&gt;can_mutate_core_state = False&lt;br&gt;━━━━━━━━━━&lt;br&gt;system_prompts/orchestration.md&lt;br&gt;+ prompt_builder.py (36KB 动态拼接)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="618" width="510" height="250" as="geometry" />
        </mxCell>

        <mxCell id="R_kernel" value="&lt;b&gt;kernel&lt;/b&gt;&lt;br&gt;backend: Claude opus-4-7 · responder-only&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;allowed_intents:&lt;/b&gt; base +&lt;br&gt;&lt;b&gt;response&lt;/b&gt; (only) + update_state&lt;br&gt;(限自己 action 的 metric 字段)&lt;br&gt;━━━━━━━━━━&lt;br&gt;独占 5 个 &lt;b&gt;KERNEL_OWNED_ACTIONS:&lt;/b&gt;&lt;br&gt;kernel_opt · integrate · deep_kernel_analysis&lt;br&gt;operator_tuning · vendor_kernel_config&lt;br&gt;━━━━━━━━━━&lt;br&gt;只响应 request{target_agent=&apos;kernel&apos;}&lt;br&gt;不 propose / 不 delegate / 不 request&lt;br&gt;system_prompts/kernel.md (IR-1~7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="580" y="618" width="510" height="250" as="geometry" />
        </mxCell>

        <mxCell id="R_critic" value="&lt;b&gt;critic&lt;/b&gt; ★ Codex no-tools (gpt-5.4)&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;allowed_intents:&lt;/b&gt; base + &lt;b&gt;review_verdict&lt;/b&gt; (only)&lt;br&gt;verdict ∈ approve · reject · redirect · advise · needs_review&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;Layer 1 (同进程):&lt;/b&gt; critic.md 极薄 (17 行 smoke-grade,&lt;br&gt;多数 auto-approve, 仅 accuracy_risk &gt; 0.3 / 名字未知 → reject)&lt;br&gt;&lt;b&gt;Layer 2 (子进程):&lt;/b&gt; CriticAgentBackend → python -m&lt;br&gt;critic-agent.runtime.cli (prepare-review · commit-review),&lt;br&gt;真正的 KB / judge bundle / session memory 在这层&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;Pending Proposal Gate:&lt;/b&gt;&lt;br&gt;orch.propose → critic.verdict → 落 task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D14B4B;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1100" y="618" width="525" height="250" as="geometry" />
        </mxCell>

        <mxCell id="R_robust" value="&lt;b&gt;robustness&lt;/b&gt; ★ Claude opus-4-7 · always-on&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;allowed_intents:&lt;/b&gt; base + &lt;b&gt;alert&lt;/b&gt; +&lt;br&gt;&lt;b&gt;update_state&lt;/b&gt; (crash_count / current_action) +&lt;br&gt;&lt;b&gt;delegate&lt;/b&gt; (限 accuracy_gate / recover /&lt;br&gt;server_lifecycle handle action) +&lt;br&gt;&lt;b&gt;kill_task&lt;/b&gt; · &lt;b&gt;force_dispatch&lt;/b&gt; · &lt;b&gt;prune_branch&lt;/b&gt; ·&lt;br&gt;&lt;b&gt;escalate_strategy_change&lt;/b&gt;&lt;br&gt;━━━━━━━━━━&lt;br&gt;Robustness 文档 60s tick (实际 Coordinator&lt;br&gt;单 tick_interval, 60s 是文档自律)&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;子进程 runtime:&lt;/b&gt; RobustnessAgentBackend → python -m&lt;br&gt;robustness-agent.src.robustness_agent.main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D14B4B;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1635" y="618" width="525" height="250" as="geometry" />
        </mxCell>

        <mxCell id="policy" value="&lt;b&gt;IntentParser + PolicyGate — 唯一 chokepoint (policy.py 504 行)&lt;/b&gt;&lt;br&gt;Transports: Claude emit_intent MCP tool_call · Codex validated_json_output 单 JSON envelope (14 个 intent_type 全枚举)&lt;br&gt;校验: ① 角色 allowed_intents 准入  ② source allowlist (REVIEW_VERDICT={critic} / KILL_TASK / FORCE_DISPATCH / PRUNE_BRANCH / ESCALATE = {robustness})&lt;br&gt;③ REQUEST_ROUTING (orchestration→{kernel} 唯一)  ④ kernel-owned 不可 delegate  ⑤ CORE_STATE_FIELDS 守门  ⑥ session_dir 路径包含 (source_file 例外 → framework_source_roots)  ⑦ baseline self-loop 防抖&lt;br&gt;&lt;b&gt;失败:&lt;/b&gt; policy_denied 写回对应 agent inbox + rule 标签 (role_permission · kernel_owned_by_kernel_agent · request_target · kill_task_source · review_verdict_source · payload · baseline_self_loop) → 下一 tick self-correct" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE4E4;strokeColor=#D14B4B;strokeWidth=2;fontColor=#000000;fontSize=13;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="884" width="2100" height="124" as="geometry" />
        </mxCell>

        <mxCell id="exec_label" value="&lt;b&gt;Action Executors&lt;/b&gt; (Python async fn · 同进程 · 单测覆盖)" style="text;html=1;align=center;verticalAlign=middle;fontColor=#000000;fontSize=14;fontStyle=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="1018" width="2080" height="22" as="geometry" />
