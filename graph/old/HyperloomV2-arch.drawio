        <mxCell id="sub_robust" value="&lt;b&gt;robustness-agent/&lt;/b&gt; ★ 真子进程&lt;br&gt;src/robustness_agent/main.py · agent.py · conductor.py · rca.py ·&lt;br&gt;factory.py · config.py · models.py&lt;br&gt;子包: checks · decision · findings · monitors · providers ·&lt;br&gt;role · runtime · signals · sources&lt;br&gt;SKILL.md + pyproject.toml (独立包)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D14B4B;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
