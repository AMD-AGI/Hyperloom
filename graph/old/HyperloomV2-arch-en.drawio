  <diagram id="hyperloom-v2-arch-en" name="Hyperloom v0.6 Implemented Architecture">
    <mxGraphModel dx="2600" dy="2000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="header" value="&lt;b&gt;Hyperloom Inference Optimizer — v0.6 Implemented Architecture (code @ 2026-05-18)&lt;/b&gt;&lt;br&gt;Single asyncio Coordinator (2949 lines) · 4 reactor roles · PolicyGate enforcement · SQLite WAL event stream · canonical order orchestration → kernel → critic → robustness, single tick_interval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFD9F2;strokeColor=#0B3D91;strokeWidth=2;fontColor=#000000;fontSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2120" height="64" as="geometry" />
        </mxCell>

        <mxCell id="user" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;inference_optimizer optimize&lt;br&gt;--model / --framework / --gpu-type&lt;br&gt;--model-class / --compare-against-gpu&lt;br&gt;--isl/--osl / --max-hours&lt;br&gt;--no-kernel / --resume / --critic-* / --robustness-*" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#000000;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="104" width="320" height="120" as="geometry" />
        </mxCell>

        <mxCell id="cli" value="&lt;b&gt;cli.py · _preflight() — 9 sequential steps&lt;/b&gt;&lt;br&gt;① credentials fallback (env &gt; .env)  ② auth aliases (SAFE_API_KEY → OPENAI/ANTHROPIC/OOB/GEAK/LLM)  ③ Python SDK auto-install  ④ auth_proxy.py source bootstrap&lt;br&gt;⑤ auth-proxy supervision + ~/.claude/config.json (force-override ANTHROPIC/OPENAI_BASE_URL → :4002)  ⑥ ROCm hygiene  ⑦ Ray + Magpie + InferenceX  ⑧ node/claude/codex CLI probe  ⑨ diagnostics&lt;br&gt;&lt;b&gt;Additional (inside _run_optimize):&lt;/b&gt; model-gate catalog probe (claude-opus-4-7 → 4-6 fallback) · gpu-type auto-detect · critic-agent runtime probe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#000000;fontSize=13;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="380" y="104" width="1530" height="120" as="geometry" />
        </mxCell>

        <mxCell id="auth_proxy" value="&lt;b&gt;auth-proxy :4002&lt;/b&gt;&lt;br&gt;x-api-key → Bearer rewrite&lt;br&gt;(AMD primus-safe gateway&lt;br&gt;only accepts Bearer; Claude&lt;br&gt;SDK sends x-api-key)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1930" y="104" width="230" height="120" as="geometry" />
        </mxCell>

        <mxCell id="coord_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F2FF;strokeColor=#1F6AA8;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="246" width="2120" height="1080" as="geometry" />
        </mxCell>

        <mxCell id="coord_label" value="&lt;b&gt;Coordinator — orchestrator/coordinator.py (2949 lines · single asyncio process)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFD9F2;strokeColor=#10497F;fontColor=#000000;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="260" width="2080" height="36" as="geometry" />
        </mxCell>

        <mxCell id="comp_label" value="&lt;b&gt;Coordinator-owned components&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontColor=#000000;fontSize=14;fontStyle=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="304" width="2080" height="22" as="geometry" />
        </mxCell>

        <mxCell id="comp_state" value="&lt;b&gt;SharedState&lt;/b&gt; (1842 lines)&lt;br&gt;state.json single writer&lt;br&gt;atomic tmp+rename&lt;br&gt;CORE_STATE_FIELDS guard:&lt;br&gt;current_best · stop_reason ·&lt;br&gt;cumulative_gain* · baseline_*&lt;br&gt;session_id · model_path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="332" width="335" height="130" as="geometry" />
        </mxCell>

        <mxCell id="comp_bus" value="&lt;b&gt;MessageBus&lt;/b&gt;&lt;br&gt;events table = source of truth&lt;br&gt;seq AUTOINCREMENT (replay-safe)&lt;br&gt;TOPIC_ALLOWLIST 23 entries:&lt;br&gt;proposal · question · answer ·&lt;br&gt;alert · request · response ·&lt;br&gt;review_verdict · kill · heartbeat ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="405" y="332" width="335" height="130" as="geometry" />
        </mxCell>

        <mxCell id="comp_tasks" value="&lt;b&gt;TaskRegistry&lt;/b&gt;&lt;br&gt;tasks table + DelegatedTask FSM&lt;br&gt;queued → running →&lt;br&gt;succeeded / failed / cancelled /&lt;br&gt;needs_manual_review&lt;br&gt;idempotency_key UNIQUE (de-dup)&lt;br&gt;requires_lanes · allowed_tools · history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="750" y="332" width="335" height="130" as="geometry" />
        </mxCell>

        <mxCell id="comp_cursor" value="&lt;b&gt;CursorStore&lt;/b&gt;&lt;br&gt;cursors table (per-agent):&lt;br&gt;last_processed_seq +&lt;br&gt;last_processed_msg_id +&lt;br&gt;processed_at&lt;br&gt;→ idempotent replay, no dup consume&lt;br&gt;Each reactor tick advances its own" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1095" y="332" width="335" height="130" as="geometry" />
        </mxCell>

        <mxCell id="comp_lock" value="&lt;b&gt;ResourceLockManager&lt;/b&gt;&lt;br&gt;leases table (lane=PK) + BEGIN IMMEDIATE&lt;br&gt;KNOWN_LANES (4):&lt;br&gt;server_lifecycle · workspace_mutation&lt;br&gt;benchmark_lane · profile_lane&lt;br&gt;LANE_CONFLICTS: bench ↔ profile ↔&lt;br&gt;server_lifecycle (busy → ROLLBACK)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1440" y="332" width="350" height="130" as="geometry" />
        </mxCell>

        <mxCell id="comp_obj" value="&lt;b&gt;Objective&lt;/b&gt; (objective.py)&lt;br&gt;Coordinator stop-decider&lt;br&gt;&lt;br&gt;TimeOnlyObjective (default)&lt;br&gt;or GainObjective&lt;br&gt;(target_gain / target_tput /&lt;br&gt;target_baseline_dir)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1800" y="332" width="360" height="130" as="geometry" />
        </mxCell>

        <mxCell id="comp_reg" value="&lt;b&gt;ActionRegistry&lt;/b&gt; — scans actions/_meta/*.yaml (20 entries) → ActionMetadata&lt;br&gt;Fields: family · cost_p50/p75 · expected_gain_pct[low,high] · accuracy_risk · crash_risk · requires_lanes · allowed_tools · side_effects · max_turns · lease_ttl_sec · pipeline_phase&lt;br&gt;&lt;b&gt;VALID_FAMILIES (7):&lt;/b&gt; prep · analysis · shallow · deep_kernel · long · creative · resilience&lt;br&gt;&lt;b&gt;VALID_PIPELINE_PHASES (8):&lt;/b&gt; prep · measure · explore · analysis · deep · validate · finalize · support" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="478" width="1030" height="100" as="geometry" />
        </mxCell>

        <mxCell id="comp_runner" value="&lt;b&gt;SubAgentRunner&lt;/b&gt;&lt;br&gt;Consumes TaskRegistry → invokes action_executors async fn&lt;br&gt;First ResourceLockManager.acquire_many(requires_lanes)&lt;br&gt;Success → tasks.state=running → run → succeeded/failed&lt;br&gt;Failure → release leases + emit alert + audit_trail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1100" y="478" width="555" height="100" as="geometry" />
        </mxCell>

        <mxCell id="comp_kreq" value="&lt;b&gt;KERNEL_REQUEST_HANDLERS&lt;/b&gt; (52KB)&lt;br&gt;&lt;b&gt;4 kinds:&lt;/b&gt; select_kernels · run_optimization · integrate · apply_patch&lt;br&gt;⚠ kernel_opt is NOT a request kind&lt;br&gt;Imports kernel-agent/tools/* in-process" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1665" y="478" width="495" height="100" as="geometry" />
        </mxCell>

        <mxCell id="agents_label" value="&lt;b&gt;4 Reactor roles&lt;/b&gt; (agent_role.py · default_role_registry)" style="text;html=1;align=center;verticalAlign=middle;fontColor=#000000;fontSize=14;fontStyle=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="590" width="2080" height="22" as="geometry" />
        </mxCell>

        <mxCell id="R_orch" value="&lt;b&gt;orchestration&lt;/b&gt;&lt;br&gt;backend: Claude opus-4-7 · tool-using&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;allowed_intents:&lt;/b&gt;&lt;br&gt;base + &lt;b&gt;propose_action&lt;/b&gt; · &lt;b&gt;delegate&lt;/b&gt;&lt;br&gt;&lt;b&gt;request&lt;/b&gt; · &lt;b&gt;update_state&lt;/b&gt;&lt;br&gt;━━━━━━━━━━&lt;br&gt;Only role allowed to emit REQUEST&lt;br&gt;(routing target → kernel only)&lt;br&gt;can_delegate_side_effects = True&lt;br&gt;can_mutate_core_state = False&lt;br&gt;━━━━━━━━━━&lt;br&gt;system_prompts/orchestration.md&lt;br&gt;+ prompt_builder.py (36KB, composed live)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="618" width="510" height="250" as="geometry" />
        </mxCell>

        <mxCell id="R_kernel" value="&lt;b&gt;kernel&lt;/b&gt;&lt;br&gt;backend: Claude opus-4-7 · responder-only&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;allowed_intents:&lt;/b&gt; base +&lt;br&gt;&lt;b&gt;response&lt;/b&gt; (only) + update_state&lt;br&gt;(limited to its own action metric fields)&lt;br&gt;━━━━━━━━━━&lt;br&gt;Owns 5 &lt;b&gt;KERNEL_OWNED_ACTIONS:&lt;/b&gt;&lt;br&gt;kernel_opt · integrate · deep_kernel_analysis&lt;br&gt;operator_tuning · vendor_kernel_config&lt;br&gt;━━━━━━━━━━&lt;br&gt;Only reacts to request{target_agent=&apos;kernel&apos;}&lt;br&gt;Never propose / delegate / request&lt;br&gt;system_prompts/kernel.md (IR-1~7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="580" y="618" width="510" height="250" as="geometry" />
        </mxCell>

        <mxCell id="R_critic" value="&lt;b&gt;critic&lt;/b&gt; ★ Codex no-tools (gpt-5.4)&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;allowed_intents:&lt;/b&gt; base + &lt;b&gt;review_verdict&lt;/b&gt; (only)&lt;br&gt;verdict ∈ approve · reject · redirect · advise · needs_review&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;Layer 1 (in-process):&lt;/b&gt; critic.md is THIN (17 lines, smoke-grade,&lt;br&gt;most actions auto-approve; reject only if accuracy_risk &gt; 0.3 /&lt;br&gt;unknown action_name)&lt;br&gt;&lt;b&gt;Layer 2 (subprocess):&lt;/b&gt; CriticAgentBackend → python -m&lt;br&gt;critic-agent.runtime.cli (prepare-review · commit-review).&lt;br&gt;Real KB / judge bundle / session memory live here.&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;Pending Proposal Gate:&lt;/b&gt;&lt;br&gt;orch.propose → critic.verdict → task lands" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D14B4B;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1100" y="618" width="525" height="250" as="geometry" />
        </mxCell>

        <mxCell id="R_robust" value="&lt;b&gt;robustness&lt;/b&gt; ★ Claude opus-4-7 · always-on&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;allowed_intents:&lt;/b&gt; base + &lt;b&gt;alert&lt;/b&gt; +&lt;br&gt;&lt;b&gt;update_state&lt;/b&gt; (crash_count / current_action) +&lt;br&gt;&lt;b&gt;delegate&lt;/b&gt; (limited to accuracy_gate / recover /&lt;br&gt;server_lifecycle handle actions) +&lt;br&gt;&lt;b&gt;kill_task&lt;/b&gt; · &lt;b&gt;force_dispatch&lt;/b&gt; · &lt;b&gt;prune_branch&lt;/b&gt; ·&lt;br&gt;&lt;b&gt;escalate_strategy_change&lt;/b&gt;&lt;br&gt;━━━━━━━━━━&lt;br&gt;Robustness docs claim 60s tick (Coordinator runs&lt;br&gt;a single tick_interval; 60s is doc-enforced)&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;Subprocess runtime:&lt;/b&gt; RobustnessAgentBackend → python -m&lt;br&gt;robustness-agent.src.robustness_agent.main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D14B4B;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1635" y="618" width="525" height="250" as="geometry" />
        </mxCell>

        <mxCell id="policy" value="&lt;b&gt;IntentParser + PolicyGate — single chokepoint (policy.py 504 lines)&lt;/b&gt;&lt;br&gt;Transports: Claude emit_intent MCP tool_call · Codex validated_json_output single JSON envelope (all 14 intent_types enumerated)&lt;br&gt;Checks: ① role allowed_intents admission  ② source allowlist (REVIEW_VERDICT={critic} / KILL_TASK / FORCE_DISPATCH / PRUNE_BRANCH / ESCALATE = {robustness})&lt;br&gt;③ REQUEST_ROUTING (orchestration→{kernel} only)  ④ kernel-owned actions not delegatable  ⑤ CORE_STATE_FIELDS guard  ⑥ session_dir path containment (source_file exception → framework_source_roots)  ⑦ baseline self-loop dampener&lt;br&gt;&lt;b&gt;On failure:&lt;/b&gt; policy_denied written into offending agent inbox + rule tag (role_permission · kernel_owned_by_kernel_agent · request_target · kill_task_source · review_verdict_source · payload · baseline_self_loop) → next tick self-correct" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE4E4;strokeColor=#D14B4B;strokeWidth=2;fontColor=#000000;fontSize=13;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="884" width="2100" height="124" as="geometry" />
        </mxCell>

        <mxCell id="exec_label" value="&lt;b&gt;Action Executors&lt;/b&gt; (Python async fns · in-process · unit-tested)" style="text;html=1;align=center;verticalAlign=middle;fontColor=#000000;fontSize=14;fontStyle=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="1018" width="2080" height="22" as="geometry" />
