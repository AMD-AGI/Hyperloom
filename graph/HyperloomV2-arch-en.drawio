<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-05-19T08:58:00.000Z" type="device" version="24.7.17">
  <diagram id="hyperloom-v08-arch-en" name="Hyperloom v0.8 Architecture">
    <mxGraphModel dx="3000" dy="2400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="2080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="header" value="&lt;b&gt;Hyperloom Inference Optimizer — v0.8 Designed Architecture (KB_design.MD §3, 2026-05-19)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Single asyncio Coordinator · 4 reactor roles + Specialist pool (NEW) · 5-phase fixed pipeline · Cortex KB / PR Monitor / local mirrors knowledge plane (NEW) · 5 lanes (incl. research_lane NEW) · PolicyGate-enforced&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFD9F2;strokeColor=#0B3D91;strokeWidth=2;fontColor=#000000;fontSize=18;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="user" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;inference_optimizer optimize&lt;br&gt;--model · --framework · --gpu-type&lt;br&gt;--model-class · --max-hours · --resume&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;v0.8 new flags:&lt;/b&gt;&lt;br&gt;--cortex-kb-url · --no-cortex&lt;br&gt;--pr-monitor-url · --no-pr-monitor&lt;br&gt;--specialist-concurrency (default 6)&lt;br&gt;--pr-feed-window-days" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#000000;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="108" width="330" height="150" as="geometry" />
        </mxCell>

        <mxCell id="cli" value="&lt;b&gt;cli.py · _preflight() — 9 steps + v0.8 Knowledge Plane probes&lt;/b&gt;&lt;br&gt;① credentials  ② auth aliases  ③ Python SDK auto-install  ④ auth_proxy bootstrap  ⑤ auth-proxy + ~/.claude/config.json (force :4002)&lt;br&gt;⑥ ROCm hygiene  ⑦ Ray + Magpie + InferenceX  ⑧ node/claude/codex CLI probe  ⑨ diagnostics&lt;br&gt;&lt;b&gt;_run_optimize:&lt;/b&gt; model-gate (claude-opus-4-7 → 4-6 fallback) · gpu-type detect · critic/robustness runtime probe&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;v0.8 additions:&lt;/b&gt; ⑩ cortex-kb HTTP probe (fail → NDJSON-only mode) · ⑪ primus-cortex-pr-api probe (fail → empty pr_feed) · ⑫ cortex_kb_flusher daemon spawn (robustness child)&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;Phase init:&lt;/b&gt; SharedState.phase = &quot;PRELUDE&quot; · phase_started_ts written" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="390" y="108" width="1670" height="150" as="geometry" />
        </mxCell>

        <mxCell id="auth_proxy" value="&lt;b&gt;auth-proxy :4002&lt;/b&gt;&lt;br&gt;x-api-key →&lt;br&gt;Bearer rewrite&lt;br&gt;(primus-safe gateway&lt;br&gt;only takes Bearer;&lt;br&gt;Claude SDK sends&lt;br&gt;x-api-key)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2080" y="108" width="180" height="150" as="geometry" />
        </mxCell>

        <mxCell id="phase_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#B47A1A;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="2220" height="118" as="geometry" />
        </mxCell>
        <mxCell id="phase_title" value="&lt;b style=&quot;color:#B47A1A&quot;&gt;Phase State Machine (NEW v0.8) — Coordinator is the sole writer; PolicyGate enforces phase_change permissions&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Each phase has an allowed action subset + entry/exit predicates. LLM roles cannot set phase directly — only emit escalate_strategy_change as advisory. recover is out-of-band at any phase (does not count toward phase progress).&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;fontColor=#000000;fontSize=12;fontStyle=4;" vertex="1" parent="1">
          <mxGeometry x="50" y="288" width="2200" height="38" as="geometry" />
        </mxCell>

        <mxCell id="ph_prelude" value="&lt;b&gt;Phase 0 PRELUDE&lt;/b&gt;&lt;br&gt;━━━━━━━━━━&lt;br&gt;Allowed: target_analysis, baseline, recover&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;Cortex T0&lt;/b&gt; find-recipe → warm_start_recipe / pitfalls&lt;br&gt;Exit: baseline_tput &gt; 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B47A1A;strokeWidth=2;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="332" width="400" height="66" as="geometry" />
        </mxCell>
        <mxCell id="ph_explore" value="&lt;b&gt;Phase 1 EXPLORE&lt;/b&gt;&lt;br&gt;━━━━━━━━━━&lt;br&gt;Allowed: explore (merged), specialist, recover&lt;br&gt;N specialists in parallel → propose → serial integrate&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;Cortex T1&lt;/b&gt; traverse → prompt · &lt;b style=&quot;color:#7A1F8C&quot;&gt;T2&lt;/b&gt; hypothesize · &lt;b style=&quot;color:#7A1F8C&quot;&gt;T3&lt;/b&gt; verify&lt;br&gt;Exit: plateau / empty proposal / explore budget hit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B47A1A;strokeWidth=2;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="460" y="332" width="480" height="66" as="geometry" />
        </mxCell>
        <mxCell id="ph_kernel" value="&lt;b&gt;Phase 2 KERNEL&lt;/b&gt;&lt;br&gt;━━━━━━━━━━&lt;br&gt;Allowed: profile (1×), kernel_opt, integrate, deep_kernel_analysis,&lt;br&gt;operator_tuning, vendor_kernel_config, recover&lt;br&gt;Exit: plateau / retry budget exhausted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B47A1A;strokeWidth=2;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="950" y="332" width="480" height="66" as="geometry" />
        </mxCell>
        <mxCell id="ph_sweep" value="&lt;b&gt;Phase 3 SWEEP&lt;/b&gt;&lt;br&gt;━━━━━━━━━━&lt;br&gt;Allowed: sweep, recover&lt;br&gt;Cross-workload validation of current_best&lt;br&gt;CONC / ISL / OSL grid · Exit: complete / budget" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B47A1A;strokeWidth=2;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1440" y="332" width="390" height="66" as="geometry" />
        </mxCell>
        <mxCell id="ph_close" value="&lt;b&gt;Phase 4 CLOSE&lt;/b&gt;&lt;br&gt;━━━━━━━━━━&lt;br&gt;Allowed: report, session_breakdown, recover&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;Cortex T4&lt;/b&gt; commit + flusher drain&lt;br&gt;breakdown v2 + cortex_session_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B47A1A;strokeWidth=2;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1840" y="332" width="410" height="66" as="geometry" />
        </mxCell>

        <mxCell id="e_p0_p1" style="endArrow=classic;html=1;rounded=0;strokeColor=#B47A1A;strokeWidth=2;" edge="1" parent="1" source="ph_prelude" target="ph_explore">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p1_p2" style="endArrow=classic;html=1;rounded=0;strokeColor=#B47A1A;strokeWidth=2;" edge="1" parent="1" source="ph_explore" target="ph_kernel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p2_p3" style="endArrow=classic;html=1;rounded=0;strokeColor=#B47A1A;strokeWidth=2;" edge="1" parent="1" source="ph_kernel" target="ph_sweep">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p3_p4" style="endArrow=classic;html=1;rounded=0;strokeColor=#B47A1A;strokeWidth=2;" edge="1" parent="1" source="ph_sweep" target="ph_close">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="coord_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F2FF;strokeColor=#1F6AA8;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="416" width="2220" height="990" as="geometry" />
        </mxCell>

        <mxCell id="coord_label" value="&lt;b&gt;Coordinator — orchestrator/coordinator.py · single asyncio process · canonical order orchestration → kernel → critic → robustness · specialist runner has per-lane concurrency&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFD9F2;strokeColor=#10497F;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="2180" height="34" as="geometry" />
        </mxCell>

        <mxCell id="comp_label" value="&lt;b&gt;Coordinator-owned components&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontColor=#000000;fontSize=13;fontStyle=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="472" width="2180" height="22" as="geometry" />
        </mxCell>

        <mxCell id="comp_state" value="&lt;b&gt;SharedState (state.json)&lt;/b&gt;&lt;br&gt;atomic tmp+rename, sole writer&lt;br&gt;&lt;b&gt;CORE_STATE_FIELDS guard:&lt;/b&gt;&lt;br&gt;current_best · stop_reason ·&lt;br&gt;baseline_tput/accuracy · session_id&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;v0.8 added:&lt;/b&gt;&lt;br&gt;phase · phase_started_ts · phase_history&lt;br&gt;warm_start_recipe · warm_start_pitfalls&lt;br&gt;explore_search (merged backends/params)&lt;br&gt;specialist_rounds[] · cortex_session_id&lt;br&gt;pending_kb_edges[]&lt;br&gt;&lt;b style=&quot;color:#D14B4B&quot;&gt;v0.8 removed:&lt;/b&gt; action_scores ·&lt;br&gt;backends_search · params_search ·&lt;br&gt;all scoring-derived fields" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=11;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="350" height="176" as="geometry" />
        </mxCell>

        <mxCell id="comp_bus" value="&lt;b&gt;MessageBus (events table)&lt;/b&gt;&lt;br&gt;source of truth&lt;br&gt;seq AUTOINCREMENT (replay-safe)&lt;br&gt;&lt;b&gt;TOPIC_ALLOWLIST:&lt;/b&gt;&lt;br&gt;proposal · question · answer · alert ·&lt;br&gt;request · response · review_verdict ·&lt;br&gt;kill · heartbeat ...&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;v0.8 new intent_type:&lt;/b&gt;&lt;br&gt;&lt;b&gt;specialist_done&lt;/b&gt; — specialist exit&lt;br&gt;{proposal_set, kb_evidence,&lt;br&gt; pr_evidence, source_evidence,&lt;br&gt; confidence, residual_questions}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=11;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="420" y="500" width="350" height="176" as="geometry" />
        </mxCell>

        <mxCell id="comp_tasks" value="&lt;b&gt;TaskRegistry (tasks table)&lt;/b&gt;&lt;br&gt;DelegatedTask FSM&lt;br&gt;queued → running →&lt;br&gt;succeeded / failed / cancelled /&lt;br&gt;needs_manual_review&lt;br&gt;idempotency_key UNIQUE (de-dup)&lt;br&gt;requires_lanes · allowed_tools · history&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;v0.8 additions:&lt;/b&gt;&lt;br&gt;task kind: &lt;b&gt;specialist&lt;/b&gt; (LLM-driven)&lt;br&gt;dual-mode dispatch&lt;br&gt;robustness scans specialist&lt;br&gt;stale-heartbeat → kill_task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=11;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="780" y="500" width="350" height="176" as="geometry" />
        </mxCell>

        <mxCell id="comp_cursor" value="&lt;b&gt;CursorStore (cursors table)&lt;/b&gt;&lt;br&gt;per-agent: last_processed_seq +&lt;br&gt;last_processed_msg_id +&lt;br&gt;processed_at&lt;br&gt;→ idempotent replay, no double-consume&lt;br&gt;Each reactor tick advances its own&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;v0.8:&lt;/b&gt;&lt;br&gt;specialist agents also hold cursors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=11;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1140" y="500" width="350" height="176" as="geometry" />
        </mxCell>

        <mxCell id="comp_lock" value="&lt;b&gt;ResourceLockManager (leases)&lt;/b&gt;&lt;br&gt;lane=PK + BEGIN IMMEDIATE&lt;br&gt;&lt;b&gt;KNOWN_LANES v0.8 = 5:&lt;/b&gt;&lt;br&gt;• server_lifecycle (cap=1)&lt;br&gt;• workspace_mutation (cap=1)&lt;br&gt;• benchmark_lane (cap=1)&lt;br&gt;• profile_lane (cap=1)&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;• research_lane (cap=N, default 6) NEW&lt;/b&gt;&lt;br&gt;LANE_CONFLICTS: bench ↔ profile ↔&lt;br&gt;server_lifecycle (busy → ROLLBACK)&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;research_lane has no conflict with above 4&lt;/b&gt;&lt;br&gt;research ↔ workspace_mutation: mutex" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=11;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1500" y="500" width="370" height="176" as="geometry" />
        </mxCell>

        <mxCell id="comp_obj" value="&lt;b&gt;Objective&lt;/b&gt; (objective.py)&lt;br&gt;Coordinator stop-decider&lt;br&gt;━━━━━━━&lt;br&gt;TimeOnlyObjective (default)&lt;br&gt;or GainObjective&lt;br&gt;━━━━━━━&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;v0.8 new stop_reason:&lt;/b&gt;&lt;br&gt;plateau_explore /&lt;br&gt;plateau_kernel&lt;br&gt;(traceable from Cortex)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=11;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1880" y="500" width="360" height="176" as="geometry" />
        </mxCell>

        <mxCell id="comp_reg" value="&lt;b&gt;ActionRegistry&lt;/b&gt; — scans actions/_meta/*.yaml → ActionMetadata&lt;br&gt;Fields: family · cost_p50/p75 · expected_gain_pct · accuracy_risk · crash_risk · requires_lanes · allowed_tools · side_effects · max_turns · lease_ttl_sec · pipeline_phase&lt;br&gt;&lt;b style=&quot;color:#D14B4B&quot;&gt;v0.8:&lt;/b&gt; pipeline_phase kept for display but &lt;b&gt;no longer drives decisions&lt;/b&gt; (decision moved to Phase state machine + LLM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=11;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="690" width="740" height="84" as="geometry" />
        </mxCell>

        <mxCell id="comp_runner" value="&lt;b&gt;SubAgentRunner (dual-mode)&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#1F6AA8&quot;&gt;deterministic mode:&lt;/b&gt; calls action_executors async fn · acquires benchmark/profile/server lane&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;specialist mode (NEW):&lt;/b&gt; spawns LLM child call (Claude/Codex) with specialist prompt · acquires research_lane · multi-turn until specialist_done · robustness watches stale-heartbeat&lt;br&gt;On success → tasks.state=running → run → succeeded/failed · On failure release leases + emit alert + audit_trail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=11;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="810" y="690" width="900" height="84" as="geometry" />
        </mxCell>

        <mxCell id="comp_kreq" value="&lt;b&gt;KERNEL_REQUEST_HANDLERS&lt;/b&gt;&lt;br&gt;&lt;b&gt;4 kinds:&lt;/b&gt; select_kernels · run_optimization · integrate · apply_patch&lt;br&gt;&lt;b style=&quot;color:#B47A1A&quot;&gt;In-process import&lt;/b&gt; of kernel-agent/tools/*&lt;br&gt;&lt;b style=&quot;color:#D14B4B&quot;&gt;PolicyGate phase-compat:&lt;/b&gt; REQUEST only accepted in Phase 2 (KERNEL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=11;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1720" y="690" width="520" height="84" as="geometry" />
        </mxCell>

        <mxCell id="comp_kp" value="&lt;b style=&quot;color:#7A1F8C&quot;&gt;KnowledgePlane facade (NEW v0.8)&lt;/b&gt; — orchestrator/knowledge_plane/&lt;br&gt;Unified abstraction over 3 backends: ① &lt;b&gt;CortexKBClient&lt;/b&gt; (HTTP / cortex-kb CLI subprocess) ② &lt;b&gt;PRMonitorClient&lt;/b&gt; (REST pre-warm + MCP forward) ③ &lt;b&gt;LocalSourceMirrors&lt;/b&gt; (path-containment-guarded Read/Grep)&lt;br&gt;Read API: find_recipe / traverse / pr_feed_warm / read_source · Write API (Coordinator-only proxy): propose_point / propose_edge / hypothesize / ingest_attempt / verify_promote / commit_session&lt;br&gt;Fallback: empty result + breakdown.warnings (non-blocking) · 5-min LRU per-gap cache for traverse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECFB;strokeColor=#7A1F8C;strokeWidth=2;fontColor=#000000;fontSize=11;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="786" width="2180" height="96" as="geometry" />
        </mxCell>

        <mxCell id="agents_label" value="&lt;b&gt;Reactor roles (4) + Specialist Pool (NEW)&lt;/b&gt; — agent_role.py · default_role_registry" style="text;html=1;align=center;verticalAlign=middle;fontColor=#000000;fontSize=13;fontStyle=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="892" width="2180" height="22" as="geometry" />
        </mxCell>

        <mxCell id="R_orch" value="&lt;b&gt;orchestration&lt;/b&gt;&lt;br&gt;Claude opus-4-7 · tool-using&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;allowed_intents:&lt;/b&gt; base + propose_action ·&lt;br&gt;delegate · request · update_state&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;v0.8 decision surface:&lt;/b&gt;&lt;br&gt;no scoreboard (removed)&lt;br&gt;cannot call cortex-kb directly&lt;br&gt;prompt fields injected by Coordinator:&lt;br&gt;warm_start · traverse subgraph · pitfalls · pr_feed&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;Phase 1 EXPLORE:&lt;/b&gt; partition gaps → N specialists&lt;br&gt;&lt;b&gt;aggregate specialist_done:&lt;/b&gt; dedup → propose_action&lt;br&gt;━━━━━━━━━━&lt;br&gt;system_prompts/orchestration.md + builder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=11;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="918" width="430" height="220" as="geometry" />
        </mxCell>

        <mxCell id="R_kernel" value="&lt;b&gt;kernel&lt;/b&gt;&lt;br&gt;Claude opus-4-7 · responder-only&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;allowed_intents:&lt;/b&gt; base + response (only)&lt;br&gt;+ update_state (its own metric fields only)&lt;br&gt;━━━━━━━━━━&lt;br&gt;Owns 5 &lt;b&gt;KERNEL_OWNED_ACTIONS:&lt;/b&gt;&lt;br&gt;kernel_opt · integrate · deep_kernel_analysis&lt;br&gt;operator_tuning · vendor_kernel_config&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b style=&quot;color:#D14B4B&quot;&gt;v0.8 phase scope:&lt;/b&gt;&lt;br&gt;Active only in Phase 2 (KERNEL)&lt;br&gt;Other phases: REQUEST → policy_denied&lt;br&gt;━━━━━━━━━━&lt;br&gt;system_prompts/kernel.md (IR-1~7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=11;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="918" width="430" height="220" as="geometry" />
        </mxCell>

        <mxCell id="R_critic" value="&lt;b&gt;critic ★&lt;/b&gt; Codex no-tools&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;allowed_intents:&lt;/b&gt; base + review_verdict (only)&lt;br&gt;verdict ∈ approve · reject · redirect · advise · needs_review&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b style=&quot;color:#D14B4B&quot;&gt;v0.8 review surface expanded:&lt;/b&gt;&lt;br&gt;① reviews propose_action (existing)&lt;br&gt;② reviews specialist hypotheses (NEW)&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;Layer 1 in-process:&lt;/b&gt; critic.md smoke-grade thin&lt;br&gt;&lt;b&gt;Layer 2 subprocess:&lt;/b&gt; CriticAgentBackend → python -m&lt;br&gt;critic-agent.runtime.cli (prepare-review · commit-review)&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;commit-review → Coordinator-proxied Cortex verify&lt;/b&gt;&lt;br&gt;(confirmed → promoted-authority EXPERIENTIAL,&lt;br&gt; refuted → negation edge auto-mint)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D14B4B;fontColor=#000000;fontSize=11;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="940" y="918" width="430" height="220" as="geometry" />
        </mxCell>

        <mxCell id="R_robust" value="&lt;b&gt;robustness ★&lt;/b&gt; Claude opus-4-7 · always-on&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;allowed_intents:&lt;/b&gt; base + alert + update_state&lt;br&gt;(crash_count) + delegate (limited) + kill_task ·&lt;br&gt;force_dispatch · prune_branch · escalate_strategy_change&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b style=&quot;color:#D14B4B&quot;&gt;v0.8 watch surface expanded:&lt;/b&gt;&lt;br&gt;① specialist stale-heartbeat scan (timeout → kill_task)&lt;br&gt;② cortex_kb_flusher process supervision (reuses&lt;br&gt;robustness_monitor.sh.example pattern)&lt;br&gt;③ pending_kb_edges leak detection&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;Subprocess runtime:&lt;/b&gt; RobustnessAgentBackend&lt;br&gt;→ python -m robustness-agent.main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D14B4B;fontColor=#000000;fontSize=11;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1380" y="918" width="430" height="220" as="geometry" />
        </mxCell>

        <mxCell id="R_spec" value="&lt;b style=&quot;color:#7A1F8C&quot;&gt;specialist (NEW)&lt;/b&gt; LLM-driven sub-agent&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;6 domains:&lt;/b&gt; kernel · framework · comm ·&lt;br&gt;compiler · system · pr_intel&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;allowed_intents:&lt;/b&gt; base + &lt;b&gt;specialist_done&lt;/b&gt;&lt;br&gt;PolicyGate: from_agent must be specialist:&amp;lt;task_id&amp;gt;&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;Tool whitelist (PolicyGate tiered):&lt;/b&gt;&lt;br&gt;Read · Grep · Glob · Bash (sub-allowlist)&lt;br&gt;&lt;b&gt;WebSearch · WebFetch&lt;/b&gt; (EXPLORE only)&lt;br&gt;&lt;b&gt;mcp__pr_monitor__*&lt;/b&gt; (any phase)&lt;br&gt;&lt;b&gt;mcp__cortex__ read-only&lt;/b&gt; (traverse/find-recipe)&lt;br&gt;━━━━━━━━━━&lt;br&gt;Holds research_lane · does NOT touch serving GPU&lt;br&gt;No patches · no E2E · no direct KB writes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECFB;strokeColor=#7A1F8C;strokeWidth=2;fontColor=#000000;fontSize=11;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1820" y="918" width="420" height="220" as="geometry" />
        </mxCell>

        <mxCell id="policy" value="&lt;b&gt;IntentParser + PolicyGate v0.8 — single chokepoint&lt;/b&gt;&lt;br&gt;Transports: Claude emit_intent MCP tool_call · Codex validated_json_output single JSON envelope (all intent_types enumerated, &lt;b style=&quot;color:#7A1F8C&quot;&gt;v0.8 adds specialist_done&lt;/b&gt;)&lt;br&gt;Checks (v0.6 carry-over): ① role allowed_intents admission  ② source allowlist (REVIEW_VERDICT={critic} / KILL/FORCE_DISPATCH/PRUNE/ESCALATE={robustness})&lt;br&gt;③ REQUEST_ROUTING (orchestration→{kernel} only)  ④ kernel-owned non-delegatable  ⑤ CORE_STATE_FIELDS guard  ⑥ session_dir path containment  ⑦ baseline self-loop dampener&lt;br&gt;&lt;b style=&quot;color:#D14B4B&quot;&gt;v0.8 new rules:&lt;/b&gt;&lt;br&gt;⑧ &lt;b&gt;phase compatibility&lt;/b&gt;: any propose_action / delegate / request must be in SharedState.phase&apos;s allowed set → policy_denied(rule=phase_incompat)&lt;br&gt;⑨ &lt;b&gt;Specialist source&lt;/b&gt;: delegate{action=&apos;specialist&apos;} only orchestration may emit + params.domain ∈ known domain set&lt;br&gt;⑩ &lt;b&gt;Specialist output&lt;/b&gt;: specialist_done only the specialist itself may emit (from_agent must be specialist:&amp;lt;task_id&amp;gt;)&lt;br&gt;⑪ &lt;b&gt;KB-write role matrix&lt;/b&gt;: hypothesize/propose-point/propose-edge/ingest-attempt/verify-promote only via Coordinator proxy; any LLM role calling cortex-kb directly → denied&lt;br&gt;⑫ &lt;b&gt;Web/PR/Cortex MCP tier&lt;/b&gt;: WebSearch/WebFetch specialist + EXPLORE only; PR Monitor MCP specialist any phase; Cortex MCP read-only traverse/find-recipe specialist only&lt;br&gt;&lt;b&gt;On failure:&lt;/b&gt; policy_denied written to offending agent inbox + rule tag → next-tick self-correct" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE4E4;strokeColor=#D14B4B;strokeWidth=2;fontColor=#000000;fontSize=11;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1">
