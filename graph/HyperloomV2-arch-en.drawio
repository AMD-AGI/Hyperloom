        <mxCell id="kp_cortex" value="&lt;b style=&quot;color:#7A1F8C&quot;&gt;Cortex KB Client&lt;/b&gt;&lt;br&gt;cortex_kb_client.py (~200 LoC subprocess wrapper)&lt;br&gt;HTTP/CLI dual-mode → kb-service.primus-cortex&lt;br&gt;&lt;b&gt;Timing hooks:&lt;/b&gt; T0 find-recipe · T1 traverse (5min LRU)&lt;br&gt;T2 propose-point/edge + hypothesize&lt;br&gt;T3 ingest-attempt + verify (confirmed/refuted)&lt;br&gt;T4 commit-session&lt;br&gt;&lt;b&gt;canonical_id&lt;/b&gt; = idempotency key (reuses idempotency_key)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECFB;strokeColor=#7A1F8C;strokeWidth=2;fontColor=#000000;fontSize=11;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1760" width="430" height="160" as="geometry" />
