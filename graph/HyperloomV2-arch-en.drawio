        <mxCell id="kp_label" value="&lt;b style=&quot;color:#7A1F8C&quot;&gt;Knowledge Plane (NEW v0.8)&lt;/b&gt; — 3 independent sources unified by KnowledgePlane facade · fallback non-blocking" style="text;html=1;align=center;verticalAlign=middle;fontColor=#000000;fontSize=13;fontStyle=4;" vertex="1" parent="1">
