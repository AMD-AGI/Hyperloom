        <mxCell id="spec_framework" value="&lt;b&gt;framework&lt;/b&gt;&lt;br&gt;sglang/vllm scheduler&lt;br&gt;cuda_graph · kv_cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A1F8C;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="396" y="578" width="240" height="84" as="geometry" />
