        <mxCell id="ph_kernel" value="&lt;b&gt;Phase 2&lt;br&gt;KERNEL&lt;/b&gt;&lt;br&gt;━━━━━━━&lt;br&gt;profile (once) · select_kernels&lt;br&gt;kernel_opt · integrate · E2E retry&lt;br&gt;5 kernel-owned actions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B47A1A;strokeWidth=2;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
