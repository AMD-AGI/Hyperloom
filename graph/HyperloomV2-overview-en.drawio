        <mxCell id="spec_title" value="&lt;b&gt;Specialist Sub-Agent Pool (NEW)&lt;/b&gt; — LLM-driven · dispatched by orchestration only in Phase 1 · holds research_lane (capacity 6) · &lt;b&gt;does NOT touch serving GPU&lt;/b&gt;&lt;br&gt;Input: gap + KB subgraph + recipe + pitfalls + PR feed · Output: &lt;b&gt;specialist_done&lt;/b&gt; intent {proposal_set, *_evidence} · &lt;b&gt;no patches · no E2E · no direct KB writes&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontColor=#000000;fontSize=11;fontStyle=4;" vertex="1" parent="1">
          <mxGeometry x="140" y="536" width="1510" height="38" as="geometry" />
        </mxCell>

        <mxCell id="spec_kernel" value="&lt;b&gt;kernel&lt;/b&gt;&lt;br&gt;attention · MoE&lt;br&gt;GEMM · fusion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A1F8C;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="146" y="578" width="240" height="84" as="geometry" />
