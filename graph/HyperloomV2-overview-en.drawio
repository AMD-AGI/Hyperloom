        <mxCell id="ph_prelude" value="&lt;b&gt;Phase 0&lt;br&gt;PRELUDE&lt;/b&gt;&lt;br&gt;━━━━━━━&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;Cortex T0&lt;/b&gt; find-recipe&lt;br&gt;baseline · target_analysis&lt;br&gt;seed warm_start_*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B47A1A;strokeWidth=2;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
