        <mxCell id="phase_title" value="&lt;b&gt;Phase State Machine&lt;/b&gt; · Coordinator is the sole writer; PolicyGate enforces phase compatibility (other roles cannot change phase)" style="text;html=1;align=center;verticalAlign=middle;fontColor=#000000;fontSize=12;fontStyle=4;" vertex="1" parent="1">
          <mxGeometry x="140" y="178" width="1510" height="20" as="geometry" />
