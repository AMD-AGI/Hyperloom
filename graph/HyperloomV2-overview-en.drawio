        <mxCell id="lane_reactors" value="&lt;b&gt;4 Reactor&lt;br&gt;Roles&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1">
