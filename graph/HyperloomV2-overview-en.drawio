        <mxCell id="spec_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECFB;strokeColor=#7A1F8C;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="130" y="530" width="1530" height="140" as="geometry" />
