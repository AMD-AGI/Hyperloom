        <mxCell id="spec_comm" value="&lt;b&gt;comm&lt;/b&gt;&lt;br&gt;RCCL / NCCL&lt;br&gt;QuickReduce" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A1F8C;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="646" y="578" width="240" height="84" as="geometry" />
        </mxCell>
        <mxCell id="spec_compiler" value="&lt;b&gt;compiler&lt;/b&gt;&lt;br&gt;torch.compile · inductor&lt;br&gt;triton · AMDGCN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A1F8C;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
