        <mxCell id="R_orch" value="&lt;b style=&quot;font-size:15px&quot;&gt;orchestration&lt;/b&gt;&lt;br&gt;Claude · tool-using&lt;br&gt;━━━━━━━━━━&lt;br&gt;Owns phase state machine&lt;br&gt;Decides within phase&apos;s allowed&lt;br&gt;action set (gaps + KB traverse)&lt;br&gt;Dispatches specialists, then&lt;br&gt;aggregates → serial integrate&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b style=&quot;color:#1F6AA8&quot;&gt;in-process&lt;/b&gt; · only role that&lt;br&gt;emits REQUEST → kernel&lt;br&gt;&lt;b style=&quot;color:#D14B4B&quot;&gt;Cannot call cortex-kb directly&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;strokeWidth=2;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="130" y="294" width="370" height="220" as="geometry" />
        </mxCell>

        <mxCell id="R_kernel" value="&lt;b style=&quot;font-size:15px&quot;&gt;kernel&lt;/b&gt;&lt;br&gt;Claude · responder-only&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b style=&quot;color:#B47A1A&quot;&gt;Only active in Phase 2&lt;/b&gt;&lt;br&gt;Non-KERNEL phase REQUESTs&lt;br&gt;denied by phase-compat rule&lt;br&gt;━━━━━━━━━━&lt;br&gt;Owns 5 kernel-owned actions:&lt;br&gt;kernel_opt · integrate&lt;br&gt;deep_kernel_analysis&lt;br&gt;operator_tuning · vendor_kernel_config&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b style=&quot;color:#1F6AA8&quot;&gt;in-process&lt;/b&gt; · imports kernel-agent/tools/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;strokeWidth=2;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="510" y="294" width="370" height="220" as="geometry" />
        </mxCell>

        <mxCell id="R_critic" value="&lt;b style=&quot;font-size:15px&quot;&gt;critic ★&lt;/b&gt;&lt;br&gt;Codex · no-tools&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;Review surface expanded:&lt;/b&gt;&lt;br&gt;1. propose_action (existing)&lt;br&gt;2. &lt;b style=&quot;color:#D14B4B&quot;&gt;specialist hypotheses (new)&lt;/b&gt;&lt;br&gt;commit-review →&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;Cortex verify&lt;/b&gt; (confirmed/refuted)&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b style=&quot;color:#D14B4B&quot;&gt;subprocess&lt;/b&gt; · python -m&lt;br&gt;critic-agent.runtime.cli&lt;br&gt;Cortex backend (KB_BASE_URL=live)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D14B4B;strokeWidth=2;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="890" y="294" width="380" height="220" as="geometry" />
        </mxCell>

        <mxCell id="R_robust" value="&lt;b style=&quot;font-size:15px&quot;&gt;robustness ★&lt;/b&gt;&lt;br&gt;Claude · always-on&lt;br&gt;━━━━━━━━━━&lt;br&gt;Scheduling police (unchanged)&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;New duties:&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#D14B4B&quot;&gt;specialist stale-heartbeat scan&lt;/b&gt;&lt;br&gt;  (kill_task on timeout)&lt;br&gt;&lt;b style=&quot;color:#D14B4B&quot;&gt;cortex_kb_flusher supervision&lt;/b&gt;&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b style=&quot;color:#D14B4B&quot;&gt;subprocess&lt;/b&gt; · python -m&lt;br&gt;robustness-agent.main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D14B4B;strokeWidth=2;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1280" y="294" width="380" height="220" as="geometry" />
        </mxCell>

        <mxCell id="lane_specialist" value="&lt;b&gt;NEW&lt;br&gt;Specialist&lt;br&gt;Pool&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAF8;strokeColor=#7A1F8C;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1">
