        <mxCell id="spec_system" value="&lt;b&gt;system&lt;/b&gt;&lt;br&gt;KFD · driver&lt;br&gt;fragmentation · dispatch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A1F8C;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1146" y="578" width="240" height="84" as="geometry" />
        </mxCell>
        <mxCell id="spec_pr" value="&lt;b&gt;pr_intel&lt;/b&gt;&lt;br&gt;PR Monitor cross-repo&lt;br&gt;feeds other specialists" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A1F8C;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1396" y="578" width="254" height="84" as="geometry" />
        </mxCell>

        <mxCell id="coord_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F2FF;strokeColor=#1F6AA8;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="686" width="1540" height="234" as="geometry" />
        </mxCell>
        <mxCell id="coord_title" value="&lt;b&gt;Coordinator&lt;/b&gt; · single asyncio process&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Owns: SharedState (incl. phase/warm_start_*/explore_search/specialist_rounds/cortex_session_id/pending_kb_edges) · MessageBus · TaskRegistry · CursorStore · ResourceLockManager (5 lanes) · ActionRegistry · SubAgentRunner (dual-mode) · KnowledgePlane facade · Objective&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFD9F2;strokeColor=#10497F;fontColor=#000000;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="130" y="696" width="1520" height="52" as="geometry" />
        </mxCell>

        <mxCell id="policy" value="&lt;b&gt;IntentParser + PolicyGate v0.8 — single chokepoint&lt;/b&gt;&lt;br&gt;Existing (v0.6): role permission · source allowlists · REQUEST routing · kernel-owned non-delegatable · core-state guard · path containment&lt;br&gt;&lt;b style=&quot;color:#D14B4B&quot;&gt;New in v0.8:&lt;/b&gt; ① phase compatibility (action ∈ phase&apos;s allowed set) ② specialist_done source check ③ KB-write role matrix (Coordinator-only proxy) ④ Web/PR/Cortex MCP tool tier (specialists only, phase-scoped)&lt;br&gt;On failure → policy_denied to offending inbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE4E4;strokeColor=#D14B4B;strokeWidth=2;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="130" y="758" width="1520" height="80" as="geometry" />
        </mxCell>

        <mxCell id="exec" value="&lt;b&gt;Action Executors&lt;/b&gt; (Python async fns · in-process) + &lt;b style=&quot;color:#7A1F8C&quot;&gt;Specialist SubAgentRunner (NEW · LLM-driven)&lt;/b&gt;&lt;br&gt;deterministic: baseline · profile · &lt;b style=&quot;color:#1F6AA8&quot;&gt;explore (merges backends+params; old yamls become internal modes)&lt;/b&gt; · sweep · pmc_roofline · target_analysis · report · session_breakdown · recover&lt;br&gt;Kernel REQUEST (4 kinds): select_kernels · run_optimization · integrate · apply_patch · &lt;b style=&quot;color:#D14B4B&quot;&gt;removed:&lt;/b&gt; scoring.py / MARATHON_PRIORS / action_scores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E9FF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="130" y="848" width="1520" height="64" as="geometry" />
        </mxCell>

        <mxCell id="lane_kp" value="&lt;b&gt;NEW&lt;br&gt;Knowledge&lt;br&gt;Plane&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAF8;strokeColor=#7A1F8C;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="936" width="70" height="120" as="geometry" />
        </mxCell>

        <mxCell id="kp_cortex" value="&lt;b style=&quot;color:#7A1F8C&quot;&gt;Cortex KB&lt;/b&gt; — kb-service (HTTP)&lt;br&gt;Graph store · hypothesize → verify → commit protocol&lt;br&gt;&lt;b&gt;T0&lt;/b&gt; find-recipe · &lt;b&gt;T1&lt;/b&gt; traverse (prompt injection) · &lt;b&gt;T2&lt;/b&gt; propose-point/edge&lt;br&gt;&lt;b&gt;T3&lt;/b&gt; ingest-attempt + verify · &lt;b&gt;T4&lt;/b&gt; session commit&lt;br&gt;NDJSON fallback → cortex_kb_flusher daemon (async, non-blocking)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECFB;strokeColor=#7A1F8C;strokeWidth=2;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="130" y="936" width="500" height="120" as="geometry" />
        </mxCell>

        <mxCell id="kp_pr" value="&lt;b style=&quot;color:#7A1F8C&quot;&gt;Primus PR Monitor&lt;/b&gt; — primus-cortex-pr-api&lt;br&gt;6 pre-indexed repos (ROCm/aiter · FlyDSL · hip · vllm · sglang · triton)&lt;br&gt;commit-level file tree + PR baseline (for cherry-pick analysis)&lt;br&gt;&lt;b&gt;REST&lt;/b&gt; (Coordinator pre-warms pr_feed → prompt)&lt;br&gt;&lt;b&gt;MCP&lt;/b&gt; (specialist mounts mcp__pr_*: list/get/patches/files/blob/baseline)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECFB;strokeColor=#7A1F8C;strokeWidth=2;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="640" y="936" width="500" height="120" as="geometry" />
        </mxCell>

        <mxCell id="kp_local" value="&lt;b&gt;Local Source Mirrors&lt;/b&gt;&lt;br&gt;framework_source_roots:&lt;br&gt;/sgl-workspace/{aiter,sglang,vllm}/&lt;br&gt;runtime/source-mirrors/{geak,OOB,TraceLens-internal}/&lt;br&gt;&lt;b&gt;Specialist tools:&lt;/b&gt; Read/Grep/Glob (read-only)&lt;br&gt;PolicyGate path-containment guard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A1F8C;strokeWidth=2;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1150" y="936" width="500" height="120" as="geometry" />
        </mxCell>

        <mxCell id="lane_persist" value="&lt;b&gt;Persist&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1">
