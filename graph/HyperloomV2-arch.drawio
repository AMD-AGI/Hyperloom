        <mxCell id="kp_local" value="&lt;b&gt;Local Source Mirrors&lt;/b&gt;&lt;br&gt;framework_source_roots:&lt;br&gt;/sgl-workspace/{aiter,sglang,vllm}/&lt;br&gt;runtime/source-mirrors/&lt;br&gt;{geak,OOB,TraceLens-internal}/&lt;br&gt;━━━━━━━&lt;br&gt;specialist 工具 Read/Grep/Glob 只读&lt;br&gt;PolicyGate source_file 路径包含校验&lt;br&gt;research ↔ workspace_mutation lane 互斥&lt;br&gt;(防 kernel apply 期间读到不一致源)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A1F8C;strokeWidth=2;fontColor=#000000;fontSize=11;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
