        <mxCell id="e_p2_p3" style="endArrow=classic;html=1;rounded=0;strokeColor=#B47A1A;strokeWidth=2;" edge="1" parent="1" source="ph_kernel" target="ph_sweep">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p3_p4" style="endArrow=classic;html=1;rounded=0;strokeColor=#B47A1A;strokeWidth=2;" edge="1" parent="1" source="ph_sweep" target="ph_close">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="coord_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F2FF;strokeColor=#1F6AA8;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="464" width="2320" height="1080" as="geometry" />
        </mxCell>

        <mxCell id="coord_label" value="&lt;b&gt;Coordinator — orchestrator/coordinator.py (单 asyncio 进程 · canonical 顺序 orchestration → kernel → critic → robustness · specialist runner per-lane 并发)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFD9F2;strokeColor=#10497F;fontColor=#000000;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="478" width="2280" height="36" as="geometry" />
        </mxCell>

        <mxCell id="comp_label" value="&lt;b&gt;Coordinator-owned 组件&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontColor=#000000;fontSize=13;fontStyle=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="522" width="2280" height="22" as="geometry" />
        </mxCell>

        <mxCell id="comp_state" value="&lt;b&gt;SharedState (state.json)&lt;/b&gt;&lt;br&gt;atomic tmp+rename 唯一写&lt;br&gt;&lt;b&gt;CORE_STATE_FIELDS 守门:&lt;/b&gt;&lt;br&gt;current_best · stop_reason ·&lt;br&gt;baseline_tput / accuracy · session_id&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;v0.8 新增:&lt;/b&gt;&lt;br&gt;phase / phase_started_ts / phase_history&lt;br&gt;warm_start_recipe / warm_start_pitfalls&lt;br&gt;explore_search (合并 backends/params)&lt;br&gt;specialist_rounds[] · cortex_session_id&lt;br&gt;pending_kb_edges[]&lt;br&gt;&lt;b style=&quot;color:#D14B4B&quot;&gt;v0.8 删除:&lt;/b&gt; action_scores · backends_search&lt;br&gt;params_search · 各种评分派生字段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=11;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="552" width="370" height="186" as="geometry" />
        </mxCell>

        <mxCell id="comp_bus" value="&lt;b&gt;MessageBus (events 表)&lt;/b&gt;&lt;br&gt;source of truth &lt;br&gt;seq AUTOINCREMENT (replay-safe)&lt;br&gt;&lt;b&gt;TOPIC_ALLOWLIST:&lt;/b&gt;&lt;br&gt;proposal · question · answer · alert ·&lt;br&gt;request · response · review_verdict ·&lt;br&gt;kill · heartbeat ...&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;v0.8 新增 intent_type:&lt;/b&gt;&lt;br&gt;&lt;b&gt;specialist_done&lt;/b&gt; — specialist 收尾&lt;br&gt;{proposal_set, kb_evidence,&lt;br&gt; pr_evidence, source_evidence,&lt;br&gt; confidence, residual_questions}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=11;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="552" width="370" height="186" as="geometry" />
        </mxCell>

        <mxCell id="comp_tasks" value="&lt;b&gt;TaskRegistry (tasks 表)&lt;/b&gt;&lt;br&gt;DelegatedTask FSM&lt;br&gt;queued → running →&lt;br&gt;succeeded / failed / cancelled /&lt;br&gt;needs_manual_review&lt;br&gt;idempotency_key UNIQUE (天然去重)&lt;br&gt;requires_lanes · allowed_tools · history&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;v0.8 新增:&lt;/b&gt;&lt;br&gt;task kind: &lt;b&gt;specialist&lt;/b&gt; (LLM-driven)&lt;br&gt;deterministic / specialist 双分流&lt;br&gt;robustness 扫 specialist&lt;br&gt;stale-heartbeat → kill_task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=11;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="820" y="552" width="370" height="186" as="geometry" />
        </mxCell>

        <mxCell id="comp_cursor" value="&lt;b&gt;CursorStore (cursors 表)&lt;/b&gt;&lt;br&gt;per-agent: last_processed_seq +&lt;br&gt;last_processed_msg_id +&lt;br&gt;processed_at&lt;br&gt;→ 幂等回放, 重启不重复消费&lt;br&gt;每个 reactor tick 推进自己的 cursor&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;v0.8:&lt;/b&gt;&lt;br&gt;specialist agent 也各持一份 cursor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=11;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1200" y="552" width="370" height="186" as="geometry" />
        </mxCell>

        <mxCell id="comp_lock" value="&lt;b&gt;ResourceLockManager (leases 表)&lt;/b&gt;&lt;br&gt;lane=PK + BEGIN IMMEDIATE&lt;br&gt;&lt;b&gt;KNOWN_LANES v0.8 = 5:&lt;/b&gt;&lt;br&gt;• server_lifecycle (cap=1)&lt;br&gt;• workspace_mutation (cap=1)&lt;br&gt;• benchmark_lane (cap=1)&lt;br&gt;• profile_lane (cap=1)&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;• research_lane (cap=N, default 6)&lt;/b&gt; NEW&lt;br&gt;LANE_CONFLICTS: bench ↔ profile ↔&lt;br&gt;server_lifecycle (busy → ROLLBACK)&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;research_lane 与上 4 lane 互不冲突&lt;/b&gt;&lt;br&gt;research ↔ workspace_mutation 互斥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=11;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1580" y="552" width="380" height="186" as="geometry" />
        </mxCell>

        <mxCell id="comp_obj" value="&lt;b&gt;Objective&lt;/b&gt; (objective.py)&lt;br&gt;Coordinator 判 stop&lt;br&gt;━━━━━━━&lt;br&gt;TimeOnlyObjective (默认)&lt;br&gt;或 GainObjective&lt;br&gt;━━━━━━━&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;v0.8 新 stop_reason:&lt;/b&gt;&lt;br&gt;plateau_explore /&lt;br&gt;plateau_kernel&lt;br&gt;(便于 Cortex 反查)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=11;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1970" y="552" width="370" height="186" as="geometry" />
        </mxCell>

        <mxCell id="comp_reg" value="&lt;b&gt;ActionRegistry&lt;/b&gt; — scans actions/_meta/*.yaml → ActionMetadata&lt;br&gt;Fields: family · cost_p50/p75 · expected_gain_pct · accuracy_risk · crash_risk · requires_lanes · allowed_tools · side_effects · max_turns · lease_ttl_sec · pipeline_phase&lt;br&gt;&lt;b style=&quot;color:#D14B4B&quot;&gt;v0.8:&lt;/b&gt; pipeline_phase 字段保留作展示但&lt;b&gt;不再驱动决策&lt;/b&gt; (决策面交给 Phase 状态机 + LLM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=11;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="752" width="780" height="90" as="geometry" />
        </mxCell>

        <mxCell id="comp_runner" value="&lt;b&gt;SubAgentRunner (双形态)&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#1F6AA8&quot;&gt;deterministic mode:&lt;/b&gt; 调 action_executors async fn · 抢 benchmark/profile/server lane&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;specialist mode (NEW):&lt;/b&gt; 起 LLM 子调用 (Claude/Codex), 注入 specialist prompt · 抢 research_lane · 多 turn 直到 specialist_done · stale-heartbeat 由 robustness 监管&lt;br&gt;成功 → tasks.state=running → 跑 → succeeded/failed · 失败释放 leases + alert + audit_trail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=11;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="850" y="752" width="900" height="90" as="geometry" />
        </mxCell>

        <mxCell id="comp_kreq" value="&lt;b&gt;KERNEL_REQUEST_HANDLERS&lt;/b&gt;&lt;br&gt;&lt;b&gt;4 kind:&lt;/b&gt; select_kernels · run_optimization · integrate · apply_patch&lt;br&gt;&lt;b style=&quot;color:#B47A1A&quot;&gt;同进程 import&lt;/b&gt; kernel-agent/tools/*&lt;br&gt;&lt;b style=&quot;color:#D14B4B&quot;&gt;PolicyGate phase-compat:&lt;/b&gt; REQUEST 仅在 Phase 2 (KERNEL) 接受" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=11;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1760" y="752" width="580" height="90" as="geometry" />
        </mxCell>

        <mxCell id="comp_kp" value="&lt;b style=&quot;color:#7A1F8C&quot;&gt;KnowledgePlane facade (NEW v0.8)&lt;/b&gt; — orchestrator/knowledge_plane/&lt;br&gt;统一对外抽象 3 个后端: ① &lt;b&gt;CortexKBClient&lt;/b&gt; (HTTP /或 subprocess cortex-kb CLI) ② &lt;b&gt;PRMonitorClient&lt;/b&gt; (REST 预热 + MCP 转发) ③ &lt;b&gt;LocalSourceMirrors&lt;/b&gt; (path-containment-guarded Read/Grep)&lt;br&gt;读侧: find_recipe / traverse / pr_feed_warm / read_source · 写侧 (仅 Coordinator 代理): propose_point / propose_edge / hypothesize / ingest_attempt / verify_promote / commit_session&lt;br&gt;失败 fallback: empty result + breakdown.warnings 加条目, 不阻塞主流程 · 5 min LRU per-gap 缓存 traverse 子图" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECFB;strokeColor=#7A1F8C;strokeWidth=2;fontColor=#000000;fontSize=11;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="854" width="2280" height="104" as="geometry" />
        </mxCell>

        <mxCell id="agents_label" value="&lt;b&gt;Reactor 角色 (4) + Specialist Pool (NEW)&lt;/b&gt; — agent_role.py · default_role_registry" style="text;html=1;align=center;verticalAlign=middle;fontColor=#000000;fontSize=13;fontStyle=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="968" width="2280" height="22" as="geometry" />
        </mxCell>

        <mxCell id="R_orch" value="&lt;b&gt;orchestration&lt;/b&gt;&lt;br&gt;Claude opus-4-7 · tool-using&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;allowed_intents:&lt;/b&gt; base + propose_action ·&lt;br&gt;delegate · request · update_state&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;v0.8 决策面:&lt;/b&gt;&lt;br&gt;不读 scoreboard (砍掉)&lt;br&gt;不直接读 KB / 不调 cortex-kb&lt;br&gt;由 Coordinator 注入 prompt 字段:&lt;br&gt;warm_start · traverse 子图 · pitfalls · pr_feed&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;Phase 1 EXPLORE:&lt;/b&gt; 分 gap 派 N specialist&lt;br&gt;&lt;b&gt;聚合 specialist_done:&lt;/b&gt; dedup 后 propose_action&lt;br&gt;━━━━━━━━━━&lt;br&gt;system_prompts/orchestration.md + builder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=11;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="996" width="450" height="240" as="geometry" />
        </mxCell>

        <mxCell id="R_kernel" value="&lt;b&gt;kernel&lt;/b&gt;&lt;br&gt;Claude opus-4-7 · responder-only&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;allowed_intents:&lt;/b&gt; base + response (only)&lt;br&gt;+ update_state (限自己 action 字段)&lt;br&gt;━━━━━━━━━━&lt;br&gt;独占 5 &lt;b&gt;KERNEL_OWNED_ACTIONS:&lt;/b&gt;&lt;br&gt;kernel_opt · integrate · deep_kernel_analysis&lt;br&gt;operator_tuning · vendor_kernel_config&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b style=&quot;color:#D14B4B&quot;&gt;v0.8 phase 约束:&lt;/b&gt;&lt;br&gt;仅 Phase 2 (KERNEL) 激活&lt;br&gt;其他 phase 收到 REQUEST → policy_denied&lt;br&gt;━━━━━━━━━━&lt;br&gt;system_prompts/kernel.md (IR-1~7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6AA8;fontColor=#000000;fontSize=11;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="520" y="996" width="450" height="240" as="geometry" />
        </mxCell>

        <mxCell id="R_critic" value="&lt;b&gt;critic ★&lt;/b&gt; Codex no-tools&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;allowed_intents:&lt;/b&gt; base + review_verdict (only)&lt;br&gt;verdict ∈ approve · reject · redirect · advise · needs_review&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b style=&quot;color:#D14B4B&quot;&gt;v0.8 评审面扩大:&lt;/b&gt;&lt;br&gt;① 评审 propose_action (原有)&lt;br&gt;② 评审 specialist 探索假设 (新)&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;Layer 1 in-process:&lt;/b&gt; critic.md 极薄 smoke-grade&lt;br&gt;&lt;b&gt;Layer 2 subprocess:&lt;/b&gt; CriticAgentBackend → python -m&lt;br&gt;critic-agent.runtime.cli (prepare-review · commit-review)&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;commit-review → Coordinator 代理 Cortex verify&lt;/b&gt;&lt;br&gt;(confirmed → promoted-authority EXPERIENTIAL,&lt;br&gt; refuted → negation edge auto-mint)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D14B4B;fontColor=#000000;fontSize=11;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="980" y="996" width="450" height="240" as="geometry" />
        </mxCell>

        <mxCell id="R_robust" value="&lt;b&gt;robustness ★&lt;/b&gt; Claude opus-4-7 · always-on&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;allowed_intents:&lt;/b&gt; base + alert + update_state&lt;br&gt;(crash_count) + delegate (limit) + kill_task ·&lt;br&gt;force_dispatch · prune_branch · escalate_strategy_change&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b style=&quot;color:#D14B4B&quot;&gt;v0.8 监控面扩大:&lt;/b&gt;&lt;br&gt;① specialist stale-heartbeat 扫描 (超时 → kill_task)&lt;br&gt;② cortex_kb_flusher 进程检活 (复用&lt;br&gt;robustness_monitor.sh.example 模式)&lt;br&gt;③ pending_kb_edges 漏验报警&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;b&gt;Subprocess runtime:&lt;/b&gt; RobustnessAgentBackend &lt;br&gt;→ python -m robustness-agent.main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D14B4B;fontColor=#000000;fontSize=11;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
