  <diagram id="hyperloom-v08-arch-cn" name="Hyperloom v0.8 详细架构">
    <mxGraphModel dx="3000" dy="2400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="2280" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="header" value="&lt;b&gt;Hyperloom Inference Optimizer — v0.8 设计架构 (KB_design.MD §3, 2026-05-19)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;单 asyncio Coordinator · 4 Reactor 角色 + Specialist 池 (NEW) · 5 阶段固化管线 · Cortex KB / PR Monitor / 本地源 三源知识平面 (NEW) · 5 lane (含 research_lane NEW) · PolicyGate 强制&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFD9F2;strokeColor=#0B3D91;strokeWidth=2;fontColor=#000000;fontSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2320" height="76" as="geometry" />
        </mxCell>

        <mxCell id="user" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;inference_optimizer optimize&lt;br&gt;--model / --framework / --gpu-type&lt;br&gt;--model-class / --compare-against-gpu&lt;br&gt;--isl/--osl / --max-hours / --resume&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;v0.8 新增:&lt;/b&gt;&lt;br&gt;--cortex-kb-url / --no-cortex&lt;br&gt;--pr-monitor-url / --no-pr-monitor&lt;br&gt;--specialist-concurrency (default 6)&lt;br&gt;--pr-feed-window-days" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#000000;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="116" width="340" height="170" as="geometry" />
        </mxCell>

        <mxCell id="cli" value="&lt;b&gt;cli.py · _preflight() — 9 步顺序执行 + v0.8 新增 Knowledge Plane probe&lt;/b&gt;&lt;br&gt;① credentials fallback  ② auth aliases  ③ Python SDK 自动装  ④ auth_proxy.py 源码 bootstrap  ⑤ auth-proxy 监管 + ~/.claude/config.json 强写 (:4002)&lt;br&gt;⑥ ROCm 卫生  ⑦ Ray + Magpie + InferenceX  ⑧ node/claude/codex CLI 探测  ⑨ diagnostics&lt;br&gt;&lt;b&gt;_run_optimize:&lt;/b&gt; model-gate (claude-opus-4-7 → 4-6 fallback) · gpu-type 探测 · critic/robustness runtime probe&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;v0.8 新增:&lt;/b&gt; ⑩ cortex-kb HTTP probe (健康检查 · 失败 → NDJSON-only 降级) · ⑪ primus-cortex-pr-api probe (失败 → specialist pr_feed 置空) · ⑫ cortex_kb_flusher daemon 拉起 (robustness 子任务)&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;Phase 状态机初始化:&lt;/b&gt; SharedState.phase = &quot;PRELUDE&quot;, phase_started_ts 写入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="400" y="116" width="1730" height="170" as="geometry" />
        </mxCell>

        <mxCell id="auth_proxy" value="&lt;b&gt;auth-proxy :4002&lt;/b&gt;&lt;br&gt;x-api-key →&lt;br&gt;Bearer 改写&lt;br&gt;(AMD primus-safe&lt;br&gt;网关; Claude SDK&lt;br&gt;走 x-api-key)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2150" y="116" width="210" height="170" as="geometry" />
        </mxCell>

        <mxCell id="phase_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#B47A1A;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="308" width="2320" height="138" as="geometry" />
        </mxCell>
        <mxCell id="phase_title" value="&lt;b style=&quot;color:#B47A1A&quot;&gt;Phase State Machine (NEW v0.8) — Coordinator 唯一写者 · 写入受 PolicyGate phase_change 规则保护&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;每段 phase 有允许 action 子集 + 进入/退出条件; LLM 角色不能直接改 phase, 仅可发 escalate_strategy_change 建议; recover 在任何 phase 都可被 robustness 触发 (out-of-band, 不计入 phase 进度)&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;fontColor=#000000;fontSize=13;fontStyle=4;" vertex="1" parent="1">
          <mxGeometry x="50" y="316" width="2300" height="38" as="geometry" />
        </mxCell>

        <mxCell id="ph_prelude" value="&lt;b&gt;Phase 0 PRELUDE&lt;/b&gt;&lt;br&gt;━━━━━━━━━━&lt;br&gt;Allowed: target_analysis, baseline, recover&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;Cortex T0&lt;/b&gt; find-recipe&lt;br&gt;写 warm_start_recipe / pitfalls&lt;br&gt;Exit: baseline_tput &gt; 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B47A1A;strokeWidth=2;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="360" width="420" height="78" as="geometry" />
        </mxCell>
        <mxCell id="ph_explore" value="&lt;b&gt;Phase 1 EXPLORE&lt;/b&gt;&lt;br&gt;━━━━━━━━━━&lt;br&gt;Allowed: explore (合并), specialist, recover&lt;br&gt;N specialist 并发 → propose → integrate 串行&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;Cortex T1&lt;/b&gt; traverse 注入 prompt · &lt;b style=&quot;color:#7A1F8C&quot;&gt;T2&lt;/b&gt; hypothesize · &lt;b style=&quot;color:#7A1F8C&quot;&gt;T3&lt;/b&gt; verify&lt;br&gt;Exit: plateau / empty proposal / explore budget" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B47A1A;strokeWidth=2;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="480" y="360" width="500" height="78" as="geometry" />
        </mxCell>
        <mxCell id="ph_kernel" value="&lt;b&gt;Phase 2 KERNEL&lt;/b&gt;&lt;br&gt;━━━━━━━━━━&lt;br&gt;Allowed: profile (1×), kernel_opt, integrate,&lt;br&gt;deep_kernel_analysis, operator_tuning,&lt;br&gt;vendor_kernel_config, recover&lt;br&gt;Exit: plateau / retry budget exhausted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B47A1A;strokeWidth=2;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="990" y="360" width="500" height="78" as="geometry" />
        </mxCell>
        <mxCell id="ph_sweep" value="&lt;b&gt;Phase 3 SWEEP&lt;/b&gt;&lt;br&gt;━━━━━━━━━━&lt;br&gt;Allowed: sweep, recover&lt;br&gt;cross-workload 验证 current_best&lt;br&gt;CONC / ISL / OSL 网格&lt;br&gt;Exit: sweep complete / budget hit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B47A1A;strokeWidth=2;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1500" y="360" width="400" height="78" as="geometry" />
        </mxCell>
        <mxCell id="ph_close" value="&lt;b&gt;Phase 4 CLOSE&lt;/b&gt;&lt;br&gt;━━━━━━━━━━&lt;br&gt;Allowed: report, session_breakdown, recover&lt;br&gt;&lt;b style=&quot;color:#7A1F8C&quot;&gt;Cortex T4&lt;/b&gt; commit + flusher drain&lt;br&gt;breakdown v2 + cortex_session_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B47A1A;strokeWidth=2;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1910" y="360" width="440" height="78" as="geometry" />
        </mxCell>

        <mxCell id="e_p0_p1" style="endArrow=classic;html=1;rounded=0;strokeColor=#B47A1A;strokeWidth=2;" edge="1" parent="1" source="ph_prelude" target="ph_explore">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p1_p2" style="endArrow=classic;html=1;rounded=0;strokeColor=#B47A1A;strokeWidth=2;" edge="1" parent="1" source="ph_explore" target="ph_kernel">
          <mxGeometry relative="1" as="geometry" />
