        <mxCell id="user" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;inference_optimizer optimize" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="130" y="100" width="230" height="68" as="geometry" />
        </mxCell>
        <mxCell id="cli" value="&lt;b&gt;cli.py — preflight + 启动 Coordinator&lt;/b&gt;&lt;br&gt;9 步: auth · ROCm · Ray/Magpie · model-gate&lt;br&gt;&lt;b&gt;新增 flag:&lt;/b&gt; --cortex-kb-url · --pr-monitor-url · --specialist-concurrency · --no-cortex/-pr-monitor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="380" y="100" width="930" height="68" as="geometry" />
        </mxCell>
        <mxCell id="auth_proxy" value="&lt;b&gt;auth-proxy :4002&lt;/b&gt;&lt;br&gt;x-api-key → Bearer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1330" y="100" width="330" height="68" as="geometry" />
