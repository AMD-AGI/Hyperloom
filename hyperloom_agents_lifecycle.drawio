<mxfile host="app.diagrams.net" agent="cursor" version="24.7.0">
  <diagram id="hyperloom-agents-lifecycle" name="Hyperloom Agents &amp; Lifecycle">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1200" math="0" background="#1E1E1E">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Hyperloom 优化流程 · Agent 与组件的通信与生命期" style="text;html=1;align=left;verticalAlign=middle;fontColor=#F5F5F5;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="14" width="1000" height="30" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="图例 Legend · 生命期 / lifecycle" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#242424;strokeColor=#7A7A7A;fontColor=#EDEDED;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1240" y="60" width="430" height="300" as="geometry" />
        </mxCell>
        <mxCell id="sw1" value="" style="rounded=2;html=1;strokeColor=none;fillColor=#173A2C;" vertex="1" parent="legend"><mxGeometry x="20" y="52" width="26" height="22" as="geometry" /></mxCell>
        <mxCell id="lb1" value="常驻 + 多轮记忆（Orchestration）" style="text;html=1;align=left;verticalAlign=middle;fontColor=#E0E0E0;fontSize=11;" vertex="1" parent="legend"><mxGeometry x="56" y="50" width="356" height="26" as="geometry" /></mxCell>
        <mxCell id="sw2" value="" style="rounded=2;html=1;strokeColor=none;fillColor=#14324F;" vertex="1" parent="legend"><mxGeometry x="20" y="90" width="26" height="22" as="geometry" /></mxCell>
        <mxCell id="lb2" value="常驻角色，但每 tick 无状态（kernel / critic / robustness）" style="text;html=1;align=left;verticalAlign=middle;fontColor=#E0E0E0;fontSize=11;" vertex="1" parent="legend"><mxGeometry x="56" y="88" width="360" height="26" as="geometry" /></mxCell>
        <mxCell id="sw3" value="" style="rounded=2;html=1;strokeColor=none;fillColor=#3E2C12;" vertex="1" parent="legend"><mxGeometry x="20" y="128" width="26" height="22" as="geometry" /></mxCell>
        <mxCell id="lb3" value="临时 / 按需子进程（specialist / framework / kernel 工具 / quantize）" style="text;html=1;align=left;verticalAlign=middle;fontColor=#E0E0E0;fontSize=11;" vertex="1" parent="legend"><mxGeometry x="56" y="126" width="366" height="26" as="geometry" /></mxCell>
        <mxCell id="sw4" value="" style="rounded=2;html=1;strokeColor=none;fillColor=#241832;" vertex="1" parent="legend"><mxGeometry x="20" y="166" width="26" height="22" as="geometry" /></mxCell>
        <mxCell id="lb4" value="持久化 / 状态层" style="text;html=1;align=left;verticalAlign=middle;fontColor=#E0E0E0;fontSize=11;" vertex="1" parent="legend"><mxGeometry x="56" y="164" width="356" height="26" as="geometry" /></mxCell>
        <mxCell id="sw5" value="" style="rounded=2;html=1;strokeColor=none;fillColor=#4A1F2B;" vertex="1" parent="legend"><mxGeometry x="20" y="204" width="26" height="22" as="geometry" /></mxCell>
        <mxCell id="lb5" value="Coordinator 中枢（所有通信经它路由）" style="text;html=1;align=left;verticalAlign=middle;fontColor=#E0E0E0;fontSize=11;" vertex="1" parent="legend"><mxGeometry x="56" y="202" width="356" height="26" as="geometry" /></mxCell>
        <mxCell id="sw6" value="" style="rounded=2;html=1;strokeColor=none;fillColor=#2B2B2B;strokeColor=#8A8A8A;" vertex="1" parent="legend"><mxGeometry x="20" y="242" width="26" height="22" as="geometry" /></mxCell>
        <mxCell id="lb6" value="入口 / 阶段链" style="text;html=1;align=left;verticalAlign=middle;fontColor=#E0E0E0;fontSize=11;" vertex="1" parent="legend"><mxGeometry x="56" y="240" width="356" height="26" as="geometry" /></mxCell>

        <!-- Entry -->
        <mxCell id="cli" value="&lt;b&gt;CLI 入口&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;inference_optimizer optimize&lt;br&gt;创建 session · 构建 backends · 调 Coordinator.run()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;align=center;verticalAlign=middle;fillColor=#2B2B2B;strokeColor=#8A8A8A;fontColor=#E6E6E6;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="quant" value="&lt;b&gt;quantization_agent&lt;/b&gt;（可选 prelude）&lt;br&gt;&lt;span style='font-size:10px'&gt;仅 --quantize；主循环前运行一次&lt;br&gt;生命期：一次性子流程&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;align=center;verticalAlign=middle;fillColor=#3E2C12;strokeColor=#E0A030;fontColor=#FFE7C2;" vertex="1" parent="1">
          <mxGeometry x="60" y="155" width="300" height="70" as="geometry" />
        </mxCell>

        <!-- reactor order note -->
        <mxCell id="note" value="每 tick reactor 顺序：orchestration → kernel_agent → critic → robustness ，随后 dispatcher / framework / enablement pump → advance_phase" style="text;html=1;align=left;verticalAlign=middle;fontColor=#AEB4BA;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="400" y="248" width="820" height="24" as="geometry" />
        </mxCell>

        <!-- Reactor roles -->
        <mxCell id="orch" value="&lt;b&gt;Orchestration（Arbor）&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;ClaudeBackend(conversational=True)&lt;br&gt;生命期：session 常驻&lt;br&gt;&lt;b&gt;记忆：✔ 真·多轮会话&lt;/b&gt;&lt;br&gt;首轮 SEED → 后续 DELTA&lt;br&gt;周期压缩进 orchestration_memory&lt;br&gt;通信：emit_intent（propose / delegate / request）&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;align=center;verticalAlign=middle;fillColor=#173A2C;strokeColor=#57C98A;fontColor=#E8F5E9;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="285" width="320" height="210" as="geometry" />
        </mxCell>
        <mxCell id="kern" value="&lt;b&gt;kernel_agent&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;ClaudeBackend（或 --kernel-codex）&lt;br&gt;生命期：backend 常驻&lt;br&gt;记忆：✗ 每 tick 无状态&lt;br&gt;通信：响应 REQUEST → RESPONSE&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;align=center;verticalAlign=middle;fillColor=#14324F;strokeColor=#4A90D9;fontColor=#E3F2FD;" vertex="1" parent="1">
          <mxGeometry x="430" y="300" width="230" height="175" as="geometry" />
        </mxCell>
        <mxCell id="crit" value="&lt;b&gt;critic&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;critic-agent 子进程（真实模式）&lt;br&gt;prepare-review → reason → commit-review&lt;br&gt;生命期：backend 常驻 / 子进程每轮新起&lt;br&gt;记忆：✗（有 KB / session 文件）&lt;br&gt;通信：审 proposal → review_verdict&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;align=center;verticalAlign=middle;fillColor=#14324F;strokeColor=#4A90D9;fontColor=#E3F2FD;" vertex="1" parent="1">
          <mxGeometry x="690" y="300" width="240" height="175" as="geometry" />
        </mxCell>
        <mxCell id="robu" value="&lt;b&gt;robustness&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;robustness-agent 子进程（真实模式）&lt;br&gt;runtime.cli tick（确定性，无 LLM）&lt;br&gt;生命期：backend 常驻 / 子进程每轮新起&lt;br&gt;记忆：✗&lt;br&gt;通信：alert / kill_task / recover&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;align=center;verticalAlign=middle;fillColor=#14324F;strokeColor=#4A90D9;fontColor=#E3F2FD;" vertex="1" parent="1">
          <mxGeometry x="960" y="300" width="250" height="175" as="geometry" />
        </mxCell>

        <!-- Coordinator hub -->
        <mxCell id="coord" value="&lt;b&gt;Coordinator（每 session 一个 · 常驻中枢）&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;reactor + dispatcher 主循环&lt;br&gt;IntentRouter · PolicyGate · 阶段机（phase machine）&lt;br&gt;所有 agent 只与它通信：intent → 校验 → 路由到 bus / task / state&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;spacing=8;align=center;verticalAlign=middle;fillColor=#4A1F2B;strokeColor=#E05A6B;fontColor=#FCE4EC;strokeWidth=2.5;" vertex="1" parent="1">
          <mxGeometry x="400" y="560" width="560" height="200" as="geometry" />
        </mxCell>

        <!-- Persistence -->
        <mxCell id="persist" value="&lt;b&gt;持久化 / 状态层&lt;/b&gt;（Coordinator 拥有）" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;arcSize=4;fontSize=12;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;fillColor=#241832;strokeColor=#9C6ADE;fontColor=#EADCF7;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1240" y="540" width="430" height="300" as="geometry" />
        </mxCell>
        <mxCell id="pstate" value="&lt;b&gt;state.json&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;orchestration_memory · phase · stack · current_best&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#33244A;strokeColor=#B48CE0;fontColor=#F3E9FF;" vertex="1" parent="persist">
          <mxGeometry x="20" y="70" width="390" height="95" as="geometry" />
        </mxCell>
        <mxCell id="pdb" value="&lt;b&gt;storage/coordinator.db&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;MessageBus events · TaskRegistry tasks · leases&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#33244A;strokeColor=#B48CE0;fontColor=#F3E9FF;" vertex="1" parent="persist">
          <mxGeometry x="20" y="180" width="390" height="95" as="geometry" />
        </mxCell>

        <!-- On-demand workers -->
        <mxCell id="spec" value="&lt;b&gt;specialist&lt;/b&gt;（EXPLORE / FRAMEWORK 按需）&lt;br&gt;&lt;span style='font-size:10px'&gt;claude 子进程 + 独立 git worktree&lt;br&gt;生命期：每个 task 一个进程，跑完即止&lt;br&gt;记忆：任务内多轮工具；跨任务无&lt;br&gt;回传：specialist_done.json&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;align=center;verticalAlign=middle;fillColor=#3E2C12;strokeColor=#E0A030;fontColor=#FFE7C2;" vertex="1" parent="1">
          <mxGeometry x="120" y="820" width="290" height="195" as="geometry" />
        </mxCell>
        <mxCell id="fw" value="&lt;b&gt;framework-agent&lt;/b&gt;（FRAMEWORK_AGENT 阶段）&lt;br&gt;&lt;span style='font-size:10px'&gt;fa phase-discover 子进程&lt;br&gt;生命期：按 batch / 候选调用&lt;br&gt;记忆：✗&lt;br&gt;回传：候选 PR → Critic 门控&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;align=center;verticalAlign=middle;fillColor=#3E2C12;strokeColor=#E0A030;fontColor=#FFE7C2;" vertex="1" parent="1">
          <mxGeometry x="440" y="820" width="280" height="195" as="geometry" />
        </mxCell>
        <mxCell id="ktools" value="&lt;b&gt;kernel-agent 工具&lt;/b&gt;（KERNEL_AGENT 阶段）&lt;br&gt;&lt;span style='font-size:10px'&gt;TraceLens / GEMM tuning / GEAK / OOB&lt;br&gt;由 kernel_request_handlers 调起&lt;br&gt;生命期：按请求的子进程&lt;br&gt;记忆：✗&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;spacing=6;align=center;verticalAlign=middle;fillColor=#3E2C12;strokeColor=#E0A030;fontColor=#FFE7C2;" vertex="1" parent="1">
          <mxGeometry x="760" y="820" width="300" height="195" as="geometry" />
        </mxCell>

        <!-- Phase chain -->
        <mxCell id="phtitle" value="&lt;b&gt;阶段链 Phase chain&lt;/b&gt;（Coordinator 单调推进）" style="text;html=1;align=left;verticalAlign=middle;fontColor=#CFEDEA;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="1035" width="500" height="26" as="geometry" />
        </mxCell>
        <mxCell id="ph1" value="PRELUDE" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#1E3A3A;strokeColor=#4FB3B3;fontColor=#DFF5F3;" vertex="1" parent="1"><mxGeometry x="120" y="1075" width="205" height="68" as="geometry" /></mxCell>
        <mxCell id="ph2" value="FRAMEWORK_AGENT" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#1E3A3A;strokeColor=#4FB3B3;fontColor=#DFF5F3;" vertex="1" parent="1"><mxGeometry x="345" y="1075" width="205" height="68" as="geometry" /></mxCell>
        <mxCell id="ph3" value="EXPLORE" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#1E3A3A;strokeColor=#4FB3B3;fontColor=#DFF5F3;" vertex="1" parent="1"><mxGeometry x="570" y="1075" width="205" height="68" as="geometry" /></mxCell>
        <mxCell id="ph4" value="KERNEL_AGENT" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#1E3A3A;strokeColor=#4FB3B3;fontColor=#DFF5F3;" vertex="1" parent="1"><mxGeometry x="795" y="1075" width="205" height="68" as="geometry" /></mxCell>
        <mxCell id="ph5" value="SWEEP" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#1E3A3A;strokeColor=#4FB3B3;fontColor=#DFF5F3;" vertex="1" parent="1"><mxGeometry x="1020" y="1075" width="205" height="68" as="geometry" /></mxCell>
        <mxCell id="ph6" value="CLOSE" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#1E3A3A;strokeColor=#4FB3B3;fontColor=#DFF5F3;" vertex="1" parent="1"><mxGeometry x="1245" y="1075" width="205" height="68" as="geometry" /></mxCell>

        <!-- Edges: entry -->
        <mxCell id="e_cli_quant" value="--quantize（可选）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9AA0A6;fontColor=#D6D6D6;labelBackgroundColor=#1E1E1E;fontSize=10;endArrow=classic;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cli" target="quant"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_cli_coord" value="启动 / run()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9AA0A6;fontColor=#D6D6D6;labelBackgroundColor=#1E1E1E;fontSize=10;endArrow=classic;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.45;entryDx=0;entryDy=0;" edge="1" parent="1" source="cli" target="coord">
