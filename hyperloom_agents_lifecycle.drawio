          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="190" /><mxPoint x="20" y="704" /></Array></mxGeometry>
        </mxCell>

        <!-- Edges: reactor roles (bidirectional) -->
        <mxCell id="e_orch" value="prompt(SEED/DELTA) ↔ emit_intent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#57C98A;fontColor=#D6D6D6;labelBackgroundColor=#1E1E1E;fontSize=10;startArrow=classic;startFill=1;endArrow=classic;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="orch" target="coord"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_kern" value="REQUEST ↔ RESPONSE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6FB7F0;fontColor=#D6D6D6;labelBackgroundColor=#1E1E1E;fontSize=10;startArrow=classic;startFill=1;endArrow=classic;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.42;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="kern" target="coord"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_crit" value="proposal ↔ review_verdict" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6FB7F0;fontColor=#D6D6D6;labelBackgroundColor=#1E1E1E;fontSize=10;startArrow=classic;startFill=1;endArrow=classic;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.62;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="crit" target="coord"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_robu" value="tick ↔ alert / kill / recover" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6FB7F0;fontColor=#D6D6D6;labelBackgroundColor=#1E1E1E;fontSize=10;startArrow=classic;startFill=1;endArrow=classic;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="robu" target="coord"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Edges: on-demand workers (bidirectional) -->
        <mxCell id="e_spec" value="delegate(task) ↔ specialist_done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E6A94D;fontColor=#D6D6D6;labelBackgroundColor=#1E1E1E;fontSize=10;startArrow=classic;startFill=1;endArrow=classic;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.18;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="spec" target="coord"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_fw" value="phase-discover ↔ candidates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E6A94D;fontColor=#D6D6D6;labelBackgroundColor=#1E1E1E;fontSize=10;startArrow=classic;startFill=1;endArrow=classic;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.47;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="fw" target="coord"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_ktools" value="trace_analyze / gemm / kernel_opt / integrate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E6A94D;fontColor=#D6D6D6;labelBackgroundColor=#1E1E1E;fontSize=10;startArrow=classic;startFill=1;endArrow=classic;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.80;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ktools" target="coord"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Edges: persistence + phase -->
        <mxCell id="e_persist" value="read / write state · db" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B48CE0;fontColor=#D6D6D6;labelBackgroundColor=#1E1E1E;fontSize=10;startArrow=classic;startFill=1;endArrow=classic;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="persist" target="coord"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_phase" value="advance_phase（单调）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#5FC7C7;fontColor=#D6D6D6;labelBackgroundColor=#1E1E1E;fontSize=10;endArrow=classic;endFill=1;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="coord" target="ph1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="46" y="730" /><mxPoint x="46" y="1109" /></Array></mxGeometry>
        </mxCell>

        <!-- Phase chain sequence -->
        <mxCell id="e_p12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5FC7C7;endArrow=classic;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ph1" target="ph2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_p23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5FC7C7;endArrow=classic;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ph2" target="ph3"><mxGeometry relative="1" as="geometry" /></mxCell>
