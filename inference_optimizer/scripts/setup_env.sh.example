#!/usr/bin/env bash
# Source this at the start of every shell call when your shell does
# not persist `export`s between invocations. Idempotent.

REPO_ROOT="${REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
export REPO_ROOT
export HYPERLOOM_KERNEL_AGENT_ROOT="$REPO_ROOT/kernel-agent"
export KERNEL_AGENT_ROOT="$HYPERLOOM_KERNEL_AGENT_ROOT"
export USER_DATA_PATH="${USER_DATA_PATH:-/workspace/hyperloom}"
export TRACELENS_ROOT="${TRACELENS_ROOT:-/wekafs/hyperloom/TraceLens-internal}"
# Optional internal extension; export only to enable it (open-source-only if unset):
# export TRACELENS_INTERNAL_ROOT=/workspace/TraceLens-internal
export OOB_SRC="${OOB_SRC:-/wekafs/hyperloom/OOB}"
# INFERENCEX_PATH and MAGPIE_DIR default under $USER_DATA_PATH/runtime/
# (Magpie clone lives there now); override only if you share Magpie /
# InferenceX checkouts across sessions.
export NODE_TLS_REJECT_UNAUTHORIZED="${NODE_TLS_REJECT_UNAUTHORIZED:-0}"
export PYTHON="${PYTHON:-$(command -v python3)}"
export PATH="$(dirname "$PYTHON"):/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH:-}"

. "$HYPERLOOM_KERNEL_AGENT_ROOT/env.sh"

# --- workload (override per run) ---
export MODEL_PATH="${MODEL_PATH:?set MODEL_PATH before sourcing}"
export FRAMEWORK="${FRAMEWORK:-vllm}"
export GPU_TYPE="${GPU_TYPE:-mi300x}"
export TP="${TP:-8}"
export CONC="${CONC:-64}"
export ISL="${ISL:-1024}"
export OSL="${OSL:-1024}"
export PRECISION="${PRECISION:-FP8}"
export TARGET_GAIN="${TARGET_GAIN:-10}"
export MAX_HOURS="${MAX_HOURS:-5}"
