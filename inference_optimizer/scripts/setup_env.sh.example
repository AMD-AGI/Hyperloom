#!/usr/bin/env bash
# Copyright Advanced Micro Devices, Inc. All rights reserved.

# Source this at the start of every shell call when your shell does
# not persist `export`s between invocations. Idempotent.
#
# NAMING: When deploying on shared filesystems (WekaFS), save this file with
# a session-scoped name to avoid race conditions from concurrent sessions:
#   $USER_DATA_PATH/optimizer_runs/setup_env_${CLAW_SESSION_ID:-$$}.sh
# NEVER use a bare "setup_env.sh" — multiple pods writing to the same path
# will overwrite each other's MODEL_PATH.

REPO_ROOT="${REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
export REPO_ROOT
export HYPERLOOM_KERNEL_AGENT_ROOT="$REPO_ROOT/kernel-agent"
export KERNEL_AGENT_ROOT="$HYPERLOOM_KERNEL_AGENT_ROOT"
export USER_DATA_PATH="${USER_DATA_PATH:-/workspace/hyperloom}"
# TRACELENS_ROOT: leave unset to let install.sh clone AMD-AGI/TraceLens to
# ${HYPERLOOM_OPEN_SOURCE_ROOT:-${TMPDIR:-/tmp}/hyperloom/open-source-repos}/TraceLens
# and pin it to a fixed SHA.
# Only export it to point at a pre-existing checkout you maintain as an
# explicit operator override — this skips both the clone and the SHA pin.
# export TRACELENS_ROOT=/path/to/your/TraceLens
# Optional internal extension; export only to enable it (open-source-only if unset):
# export TRACELENS_INTERNAL_ROOT=/workspace/TraceLens-internal
# OOB now ships inside the KernelForge checkout ($FORGE_PATH/OOB); derive it
# from the forge path so a separate OOB path no longer needs to be provided.
export OOB_SRC="${OOB_SRC:-${FORGE_PATH:-/wekafs/KernelForge}/OOB}"
# INFERENCEX_PATH and MAGPIE_PATH default under
# ${HYPERLOOM_OPEN_SOURCE_ROOT:-${TMPDIR:-/tmp}/hyperloom/open-source-repos}/.
# Override only if you share Magpie / InferenceX checkouts across sessions.
export NODE_TLS_REJECT_UNAUTHORIZED="${NODE_TLS_REJECT_UNAUTHORIZED:-0}"
export PYTHON="${PYTHON:-$(command -v python3)}"
export PATH="$(dirname "$PYTHON"):/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH:-}"

. "$HYPERLOOM_KERNEL_AGENT_ROOT/env.sh"

# --- workload (override per run) ---
export MODEL_PATH="${MODEL_PATH:?set MODEL_PATH before sourcing}"
export FRAMEWORK="${FRAMEWORK:-vllm}"
export GPU_TYPE="${GPU_TYPE:-mi300x}"
export TP="${TP:-8}"
export CONC="${CONC:-64}"
export ISL="${ISL:-1024}"
export OSL="${OSL:-1024}"
export PRECISION="${PRECISION:-FP8}"
export TARGET_GAIN="${TARGET_GAIN:-10}"
export MAX_HOURS="${MAX_HOURS:-5}"
