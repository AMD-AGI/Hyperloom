# Hyperloom Environment Configuration
# Copy this file to .env and fill in the values:
#   cp .env.template .env

# Two ways to configure LLM access:
#   * Single gateway (default): one endpoint serves both Claude and GPT —
#     set SAFE_API_KEY + OPENAI_BASE_URL below, leave the split block commented.
#   * Separate gateways: Claude and GPT live on different endpoints —
#     uncomment the "Separate Anthropic + OpenAI gateways" block below.

# API key for the LiteLLM gateway (starts with ak-). Used in the default
# single-gateway setup where Claude and GPT share one endpoint; for separate
# gateways, set the per-provider keys in the optional block below instead.
SAFE_API_KEY=ak-your-api-key-here

# Gateway URL. Defaults to the AMD Primus-Safe gateway, but any
# OpenAI-compatible (LiteLLM-style) /v1 endpoint works — point this at a
# self-hosted or third-party gateway to run off the AMD network (#340).
# OPENAI_BASE_URL=https://global.primus-safe.amd.com/api/v1/llm-proxy/v1

# --- Separate Anthropic + OpenAI gateways (optional) ------------------------
# Only needed when Claude and GPT models live on DIFFERENT gateways. Set the
# Anthropic endpoint + key here; keep OPENAI_BASE_URL above for the GPT side
# and add its key. Leave this block commented to use the single gateway above.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# OPENAI_API_KEY=sk-xxxxx

# --- Non-AMD-network deployment (#340) --------------------------------------
# To run on Vultr / TensorWave / a self-hosted gateway instead of the AMD
# network, set OPENAI_BASE_URL + SAFE_API_KEY above to your endpoint, then:
#   1. Allow a custom orchestration model id that your gateway serves. The
#      default hard-gates to AMD's opus-4-7/4-6; opt out and the model is
#      validated against your gateway's /models catalog instead.
# INFERENCE_OPTIMIZER_ALLOW_CUSTOM_ORCH_MODEL=1
# CLAUDE_MODEL=your-gateway-orchestration-model
# CODEX_MODEL=your-gateway-kernel-model

# --- GEAK / generic LLM endpoint override (#521) ----------------------------
# GEAK runs in a separate network namespace and may not reach the gateway
# directly. By default GEAK_BASE_URL/LLM_API_BASE inherit OPENAI_BASE_URL; set
# them explicitly (e.g. a host-local reverse tunnel) to give the Kernel-agent a
# routable LLM endpoint. Preflight preserves these operator overrides.
# GEAK_BASE_URL=https://127.0.0.1:18444/api/v1/llm-proxy/v1
# LLM_API_BASE=https://127.0.0.1:18444/api/v1/llm-proxy/v1

# TraceLens public repo checkout. Leave empty to auto-clone under
# $HYPERLOOM_OPEN_SOURCE_ROOT (default /opt/hyperloom/open-source-repos).
# TRACELENS_ROOT=
# OPTIONAL internal extension (roofline gap, gains, MI355/MI455 MAF). Set to its
# checkout path ONLY to enable it; leave empty for the open-source-only report.
# Presence of this value is the sole switch — there is no separate toggle.
# TRACELENS_INTERNAL_ROOT=

# (Optional) Override framework source roots for PolicyGate + flag discovery.
# Colon-separated list; unioned with defaults (/sgl-workspace/{aiter,sglang,vllm}/).
# Populated automatically by src/hyperloom/inference_optimizer/assets/install.sh probe.
# INFERENCE_OPTIMIZER_FRAMEWORK_SOURCE_ROOTS=

# Writable artifact root: hosts every session dir, optimizer_runs/, and the
# runtime/ tree generated by install.sh (Magpie clone, kernel-agent.env.sh,
# GEAK config, etc.). The default /workspace/hyperloom matches the in-code
# fallback in src/hyperloom/inference_optimizer/assets/install.sh and
# src/hyperloom/agents/kernel/scripts/install.sh; override when /workspace is
# read-only or you want session
# output on a faster / bigger volume.
USER_DATA_PATH=/workspace/hyperloom

# (Optional) Live Langfuse trace push. Default OFF: the local
# reports/trace/*.jsonl ledger is always written; set this to 1 to ALSO mirror
# every LLM call into a Langfuse deployment in real time. When this flag is on,
# src/hyperloom/inference_optimizer/assets/install.sh auto-installs the `langfuse` SDK for you (it is skipped
# entirely when the flag is off, so non-Langfuse environments stay lean); you
# do NOT need a separate `pip install '...[trace]'`. Set the three LANGFUSE_*
# connection vars below too — any missing piece degrades to a safe no-op.
# HYPERLOOM_LANGFUSE_ENABLE=1
# LANGFUSE_HOST=https://langfuse.your-domain
# LANGFUSE_PUBLIC_KEY=pk-...
# LANGFUSE_SECRET_KEY=sk-...

# --- GEMM-tune KB short-circuit (optional) ---------------------------------
# Reuse previously-tuned GEMM configs from gemm-tune-kb (gbrain) instead of
# re-running tuning. Disabled by default. The gemm-tune backend must be 'forge'
# (the default) for KB read to apply — the GEAK backend has no KB-read path.
# GEMM_TUNING_BACKEND=forge
# FORGE_GEMM_TUNE_KB_READ=1
# Also short-circuit on candidate-status pages (micro-validated but not yet
# confirmed). Without this, only 'confirmed' KB pages are applied.
# FORGE_GEMM_TUNE_KB_ACCEPT_CANDIDATE=1
# gbrain endpoint + token for the gemm-tune / recipe KBs. Base URL defaults to
# the in-cluster primus-claw-dev service; a token is required for any KB read.
# GBRAIN_BASE_URL=http://gbrain.primus-claw-dev.svc.cluster.local:80
# GBRAIN_TOKEN=gbrain_your-token-here

# --- Kernel-opt backend ladder order (optional) ----------------------------
# Comma-separated, ordered list of source-level kernel-opt backends to try.
# Valid values: forge, geak_v3. Default is the full ladder 'forge,geak_v3';
# set to restrict/reorder — e.g. 'forge' for a strict forge-only run.
# KERNEL_OPT_BACKEND_ORDER=forge,geak_v3
# KERNEL_OPT_BACKENDS is accepted as a legacy alias for KERNEL_OPT_BACKEND_ORDER.

# --- Trace analysis route (optional) ---------------------------------------
# 'agent' (default): LLM-driven TraceLens analysis. 'deterministic': run the
# TraceLens Python toolchain directly (no LLM) for a faster, reproducible
# analysis that does not consume the orchestration model.
# HYPERLOOM_TRACE_ANALYSIS_ROUTE=deterministic

# --- Quantization master switch (optional) ---------------------------------
# Deterministic on/off gate for the quantization prelude. Quantization runs
# ONLY when this is truthy (1/true/yes/on). Even if --quantize/--quantize-scheme
# is present, it is SKIPPED unless this env is on (emits QUANTIZATION_SKIPPED:
# and continues on the un-quantized model). Lets a frontend/launcher control
# quantization via a sandbox env flag instead of relying on agent judgement.
# Default (unset) = disabled.
# HYPERLOOM_QUANTIZE_ENABLED=1
