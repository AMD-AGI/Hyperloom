# PRISM Environment Configuration
# Copy this file to .env and fill in the values:
#   cp .env.template .env

# API key for the LiteLLM gateway (starts with ak-)
SAFE_API_KEY=ak-your-api-key-here

# Gateway URL. Defaults to the AMD Primus-Safe gateway, but any
# OpenAI-compatible (LiteLLM-style) /v1 endpoint works — point this at a
# self-hosted or third-party gateway to run off the AMD network (#340).
OPENAI_BASE_URL=https://core42.primus-safe.amd.com/api/v1/llm-proxy/v1

# --- Non-AMD-network deployment (#340) --------------------------------------
# To run on Vultr / TensorWave / a self-hosted gateway instead of the AMD
# network, set OPENAI_BASE_URL + SAFE_API_KEY above to your endpoint, then:
#   1. Allow a custom orchestration model id that your gateway serves. The
#      default hard-gates to AMD's opus-4-7/4-6; opt out and the model is
#      validated against your gateway's /models catalog instead.
# INFERENCE_OPTIMIZER_ALLOW_CUSTOM_ORCH_MODEL=1
# CLAUDE_MODEL=your-gateway-orchestration-model
# CODEX_MODEL=your-gateway-kernel-model

# --- GEAK / OOB endpoint override (#521) ------------------------------------
# GEAK runs in a separate network namespace and may not reach the gateway
# directly. By default GEAK_BASE_URL/OOB_BASE_URL inherit OPENAI_BASE_URL; set
# them explicitly (e.g. a host-local reverse tunnel) to give the kernel agent
# a routable LLM endpoint. Preflight preserves these operator overrides and
# only force-rewrites the legacy 127.0.0.1:4002 leftover.
# GEAK_BASE_URL=https://127.0.0.1:18444/api/v1/llm-proxy/v1
# OOB_BASE_URL=https://127.0.0.1:18444/api/v1/llm-proxy/v1

# (Optional) Cursor SDK key for the OOB cursor kernel-opt backend.
# Independent issuer (Cursor account, prefix `crsr_...`); never inherited
# from SAFE_API_KEY. Leave empty to auto-skip cursor from default backend
# selection — Hyperloom keeps working with claude/codex/geak only.
CURSOR_API_KEY=
# TraceLens public repo checkout. Leave empty to auto-clone under
# $USER_DATA_PATH/runtime/source-mirrors/.
TRACELENS_ROOT=
# OPTIONAL internal extension (roofline gap, gains, MI355/MI455 MAF). Set to its
# checkout path ONLY to enable it; leave empty for the open-source-only report.
# Presence of this value is the sole switch — there is no separate toggle.
TRACELENS_INTERNAL_ROOT=

# (Optional) Override framework source roots for PolicyGate + flag discovery.
# Colon-separated list; unioned with defaults (/sgl-workspace/{aiter,sglang,vllm}/).
# Populated automatically by inference_optimizer/scripts/install.sh probe.
INFERENCE_OPTIMIZER_FRAMEWORK_SOURCE_ROOTS=

# Writable artifact root: hosts every session dir, optimizer_runs/, and the
# runtime/ tree generated by install.sh (Magpie clone, kernel-agent.env.sh,
# GEAK config, etc.). The default /workspace/hyperloom matches the in-code
# fallback in inference_optimizer/scripts/install.sh and kernel-agent/scripts/
# install.sh; override when /workspace is read-only or you want session
# output on a faster / bigger volume.
USER_DATA_PATH=/workspace/hyperloom

# (Optional) Live Langfuse trace push. Default OFF: the local
# reports/trace/*.jsonl ledger is always written; set this to 1 to ALSO mirror
# every LLM call into a Langfuse deployment in real time. When this flag is on,
# scripts/install.sh auto-installs the `langfuse` SDK for you (it is skipped
# entirely when the flag is off, so non-Langfuse environments stay lean); you
# do NOT need a separate `pip install '...[trace]'`. Set the three LANGFUSE_*
# connection vars below too — any missing piece degrades to a safe no-op.
# HYPERLOOM_LANGFUSE_ENABLE=1
# LANGFUSE_HOST=https://langfuse.your-domain
# LANGFUSE_PUBLIC_KEY=pk-...
# LANGFUSE_SECRET_KEY=sk-...
