# PRISM Environment Configuration
# Copy this file to .env and fill in the values:
#   cp .env.template .env

# ─── GEAK Agent (required for kernel optimization) ───────────────────────────

# Authorization key for the GEAK MCP server
GEAK_AUTH_KEY=your-geak-auth-key-here

# ─── TraceLens Agentic Analysis (required for profiling analysis) ────────────────────

# TraceLens runs via local CLI: pip install -e /hyperloom/TraceLens-internal
# Ensure Node.js is installed for the npx-based MCP transport.

# ─── LiteLLM Gateway (if using LLM-powered analysis scripts) ────────────────

# API key for the LiteLLM gateway (starts with sk-)
LITELLM_API_KEY=sk-your-api-key-here

# Gateway URL
LITELLM_BASE_URL=https://example-internal-host.invalid/llm-gateway/v1

# Model to use (default: claude-opus-4-6)
LITELLM_MODEL=claude-opus-4-6

# ─── Inference Optimizer session directory ──────────────────────────────────
#
# `USER_DATA_PATH` is the knob for where Hyperloom writes the session
# directory (state.json, manifest.json, runs/, kernel-agent workspaces,
# logs, etc.).
#
# Resolution order (see `inference_optimizer/paths.py::session_dir`):
#   1. $USER_DATA_PATH       (this var)
#   2. /workspace/hyperloom  (default)
#
# Set this when /workspace/hyperloom is unwritable (sandboxed runners,
# CI), or when you want the session under WekaFS / NFS for archival.
# USER_DATA_PATH=/workspace/hyperloom
